@using tubes_kpl.Models
@inject NavigationManager Nav
<a href="/details/@(Campaign.Id)">
    <div class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-level-1 border border-secondary-fixed flex flex-col hover:shadow-level-2 transition-shadow">
        <div class="relative h-48">
            <img alt="@Campaign.Title" class="w-full h-full object-cover" src="@(string.IsNullOrEmpty(Campaign.ImageUrl) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuClC83y2ZvIWQseaFrpgEgm7EpYyj5nIIGA2_x_1l7fe7H7Snnx-aNkJH4v-Gqvu0ZgYF6hXAlL7RzkWSTU5ySl-ppV7F4Z2FG9rp8Bt0d9jBW0ySAOegYf_hxM9KSqPAtPqM06cZNG-OqOrwW1XzQTNfOfasl50LGrJ3h2s3_k-OgRrD2ycGxE2enbUbKub-PCJJdonhXr75TlLWo3WeuxCQRh2vn4hdFTz--FgTxXTTNT-c3ArGxx9vhD0V-_S6X5ePK9FBdHAZE" : Campaign.ImageUrl)"/>
        </div>
        <div class="p-6 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-2 line-clamp-2">@Campaign.Title</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-2">@Campaign.Description</p>
            <div class="mt-auto">
                <div class="flex justify-between items-end mb-2">
                    <div class="font-label-sm text-label-sm text-on-surface-variant">Raised: <span class="text-on-surface font-semibold">Rp. @Campaign.CollectedAmount</span> of Rp. @Campaign.TargetAmount</div>
                    <div class="font-label-sm text-label-sm text-primary font-bold">@(Campaign.TargetAmount > 0 ? (int)(Campaign.CollectedAmount / Campaign.TargetAmount * 100) : 0)%</div>
                </div>
                <div class="h-2 bg-secondary-fixed rounded-full overflow-hidden mb-4">
                    <div class="h-full bg-tertiary-container rounded-full" style="width: @(Campaign.TargetAmount > 0 ? (int)(Campaign.CollectedAmount / Campaign.TargetAmount * 100) : 0)%;"></div>
                </div>
                <div class="flex justify-between items-center">
                    <a href="/details/@(Campaign.Id)" class="bg-tertiary-container hover:bg-tertiary text-on-tertiary px-4 py-2 rounded-full font-label-md text-label-md transition-colors shadow-sm inline-block text-center">
                        Donate Now
                    </a>
                </div>
            </div>
        </div>
    </div>
</a>

@code {
    [Parameter]
    public Campaign Campaign { get; set; } = new();
}
