</HeadContent>
<div class="bg-background text-on-surface min-h-screen">
    <!-- Top Navigation Bar -->
    <header class="w-full h-16 bg-surface-container-lowest border-b border-outline-variant flex items-center justify-between px-gutter sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <span class="font-headline-md text-headline-md font-bold text-primary">KindCapital</span>
            <div class="hidden md:flex items-center bg-surface-container-low px-3 py-1.5 rounded-lg border border-outline-variant ml-4">
                <span class="material-symbols-outlined text-outline text-[20px]">search</span>
                <input class="bg-transparent border-none focus:ring-0 font-body-md text-body-md text-on-surface-variant w-64" placeholder="Search campaigns..." type="text">
            </div>
        </div>
        <div class="flex items-center gap-4">
            <a href="/penyelenggara/dashboard/create-campaign" class="hidden md:flex items-center gap-2 px-4 py-2 bg-primary text-on-primary rounded-lg font-bold font-label-md hover:shadow-lg transition-all active:scale-95"><span class="material-symbols-outlined text-[20px]">add_circle</span>Create New Campaign</a>
            <button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-colors">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-colors">
                <span class="material-symbols-outlined">help</span>
            </button>
            <div class="w-10 h-10 rounded-full overflow-hidden border border-outline-variant">
                <img class="w-full h-full object-cover" data-alt="A professional headshot of a friendly-looking humanitarian organization manager. The subject is a woman in her 40s with a warm smile, set against a blurred, bright office background with soft natural lighting. The image maintains the KindCapital color palette with subtle blue and clean white tones." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAEnufoG6LIEUNKrGwoyUNhvSedt1x5J4GpWyq-2LhQQCXMXQH4Ir8h6nA-FmDISHSw2CqIUgnk42gcPgz1MjutyO1yOZGlECAIojhXZNmWhYbI_YvQiaI9S4nQzd4X0HsgDHwugzGyu5mlDV9tupnKL56NYXEQwg_eVbnPFGByomTL-9vACL86_WXXeupcsTN36rZAjb3RV3u_mQmD47OjBdEfH1xt5M-ByowHQccfTCWRWsJt3GisoKYZ9rVPLDetfS3QcrR8fxum">
            </div>
        </div>
    </header>
    <div class="flex min-h-[calc(100vh-64px)]">
        <!-- Side Navigation Bar -->
        <nav class="hidden md:flex flex-col w-64 bg-surface-container-lowest border-r border-outline-variant py-stack-md sticky top-16 h-[calc(100vh-64px)]">
            <div class="px-4 mb-stack-md">
                <h2 class="font-headline-md text-headline-md font-black text-primary">KindCapital</h2>
                <p class="font-label-md text-label-md text-on-surface-variant">Humanitarian Portal</p>
            </div>
            <div class="flex-grow space-y-1 px-2">
                <!-- Dashboard Active -->
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-primary bg-secondary-container rounded-lg font-bold transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                    <span class="font-label-md text-label-md">Dashboard</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="campaign">campaign</span>
                    <span class="font-label-md text-label-md">Campaigns</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="volunteer_activism">volunteer_activism</span>
                    <span class="font-label-md text-label-md">Donations</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="assessment">assessment</span>
                    <span class="font-label-md text-label-md">Reports</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="settings">settings</span>
                    <span class="font-label-md text-label-md">Settings</span>
                </a>
            </div>
            <div class="px-4 mb-stack-md">
                <a href="/penyelenggara/dashboard/create-campaign" class="w-full py-3 bg-primary text-on-primary rounded-lg font-bold font-label-md hover:shadow-lg transition-all active:scale-95 text-center block">
                    Start Campaign
                </a>
            </div>
            <div class="border-t border-outline-variant pt-stack-sm space-y-1 px-2">
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="contact_support">contact_support</span>
                    <span class="font-label-md text-label-md">Support</span>
                </a>
                <a class="flex items-center gap-3 px-4 py-3 cursor-pointer text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-all duration-200" href="#">
                    <span class="material-symbols-outlined" data-icon="logout">logout</span>
                    <span class="font-label-md text-label-md">Logout</span>
                </a>
            </div>
        </nav>
        <!-- Main Content Area -->
        <main class="flex-grow p-gutter md:p-stack-lg max-w-7xl mx-auto w-full">
            <section class="mb-stack-lg">
                <h1 class="font-headline-xl text-headline-xl text-primary mb-2">Welcome back, @userName</h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant">Manage your active initiatives and launch new humanitarian efforts.</p>
            </section>
            <!-- Statistics Grid -->

            <div class="grid gap-stack-lg w-full">
                <!-- Primary Column: Recent Campaigns -->
                <div class="space-y-stack-md w-full">
                    <div class="flex items-center justify-between">
                        <h2 class="font-headline-lg text-headline-lg text-on-surface">Campaign Saya</h2>
                        <button class="text-primary font-bold font-label-md hover:underline">View All</button>
                    </div>
                    @if (campaigns == null)
                    {
                        <div class="text-center py-8">
                            <p class="text-on-surface-variant font-body-md">Loading campaigns...</p>
                        </div>
                    }
                    else if (campaigns.Count == 0)
                    {
                        <div class="text-center py-8">
                            <p class="text-on-surface-variant font-body-md">No campaigns found.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var campaign in campaigns)
                        {
                            var progress = campaign.TargetAmount > 0 ? (campaign.CollectedAmount / campaign.TargetAmount) * 100 : 0;
                            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant group hover:border-primary hover:shadow-lg transition-all duration-300">
                                <div class="flex flex-col md:flex-row gap-6">
                                    <div class="w-full md:w-48 aspect-video rounded-lg overflow-hidden bg-surface-container flex-shrink-0">
                                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@(string.IsNullOrEmpty(campaign.ImageUrl) ? "https://placehold.co/600x400" : campaign.ImageUrl)">
                                    </div>
                                    <div class="flex-grow flex flex-col justify-between">
                                        <div>
                                            <div class="flex items-center justify-between mb-2">
                                                <h3 class="font-headline-md text-headline-md text-on-surface">@campaign.Title</h3>
                                                @if (campaign.IsActive)
                                                {
                                                    <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-label-md font-bold">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="px-3 py-1 bg-surface-container text-on-surface-variant rounded-full text-label-md font-bold">Completed</span>
                                                }
                                            </div>
                                            <p class="font-body-md text-body-md text-on-surface-variant mb-4">@campaign.Description</p>
                                        </div>
                                        <div class="space-y-4">
                                            <div class="space-y-2">
                                                <div class="flex justify-between text-label-md">
                                                    <span class="text-on-surface-variant">Progress: <span class="text-primary font-bold">@progress.ToString("0.##")%</span></span>
                                                    <span class="text-on-surface-variant">Target: $@campaign.TargetAmount</span>
                                                </div>
                                                <div class="w-full h-2 bg-surface-container rounded-full overflow-hidden">
                                                    <div class="h-full bg-primary progress-bar-fill" style="width: @progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                                                </div>
                                            </div>
                                            <div class="flex gap-3">
                                                <button class="flex-grow px-4 py-2 bg-secondary-container text-on-secondary-container rounded-lg font-bold font-label-md hover:bg-surface-container-high transition-all active:scale-95">Post Update</button>
                                                <a href="/penyelenggara/dashboard/editdetail/@campaign.Id" class="flex-grow px-4 py-2 bg-primary text-on-primary rounded-lg font-bold font-label-md hover:shadow-lg transition-all active:scale-95 text-center block">Edit Detail</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <!-- Secondary Column: Recent Donations Activity -->

            </div>
        </main>
    </div>
    <!-- Floating Action Button for Mobile -->
    <a href="/penyelenggara/dashboard/create-campaign" class="md:hidden fixed bottom-6 right-6 w-14 h-14 bg-primary text-on-primary rounded-full shadow-xl flex items-center justify-center active:scale-95 transition-transform">
        <span class="material-symbols-outlined text-[28px]">add</span>
    </a>
    <script>
        // Simple Micro-interactions
        document.querySelectorAll('.active\\:scale-95').forEach(button => {
        button.addEventListener('mousedown', () => button.classList.add('scale-95'));
        button.addEventListener('mouseup', () => button.classList.remove('scale-95'));
        });

        // Simulating progressive bar loading on mount
        window.addEventListener('load', () => {
        const bars = document.querySelectorAll('.progress-bar-fill');
        bars.forEach(bar => {
        const width = bar.style.width;
        bar.style.width = '0';
        setTimeout(() => {
        bar.style.width = width;
        }, 100);
        });
        });
    </script>


</div>

@code {
    private List<Campaign>? campaigns;
    private string userName = "User"; // Fallback name
    private string? token;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        var client = HttpClientFactory.CreateClient("BackendAPI");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        try
        {
            // Attempt to get user from backend
            var response = await client.GetAsync("/api/auth/me");
            if (!response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();
            if (authResponse?.User != null && !string.IsNullOrWhiteSpace(authResponse.User.Name))
            {
                userName = authResponse.User.Name;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching user data: {ex.Message}");
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            campaigns = await client.GetFromJsonAsync<List<Campaign>>("/api/campaign");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching campaigns: {ex.Message}");
            campaigns = new List<Campaign>(); // fallback
        }
    }

    public class AuthResponse
    {
        public UserResponseDTO? User { get; set; }
    }

    public class UserResponseDTO
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
    }

    public class Campaign
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal TargetAmount { get; set; }
        public decimal CollectedAmount { get; set; }
        public string? ImageUrl { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}