@page "/admin/applicants"
@rendermode InteractiveServer
@using tubes_kpl.Services
@inject AdminApiService ApiService

<HeadContent>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <title>Application Verification - HumanityFlow Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff", "on-error-container": "#93000a",
                        "on-background": "#141d23", "error-container": "#ffdad6",
                        "background": "#f6faff", "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106", "inverse-surface": "#293138",
                        "tertiary": "#004c17", "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4", "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4", "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566", "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c", "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff", "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2", "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60", "outline": "#727784",
                        "secondary-fixed": "#e1e3e4", "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a", "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3", "surface-tint": "#115cb9",
                        "on-primary": "#ffffff", "primary": "#003f87",
                        "on-surface": "#141d23", "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e", "surface-container": "#e6eff8",
                        "surface": "#f6faff", "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff", "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75", "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d", "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff", "on-primary-fixed-variant": "#004491",
                        "surface-container-low": "#ecf5fe"
                    },
                    "borderRadius": { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px" },
                    "spacing": { "stack-lg": "32px", "stack-sm": "8px", "stack-md": "16px", "gutter": "24px", "margin-desktop": "40px", "base": "8px", "container-max": "1280px" },
                    "fontFamily": { "headline-md": ["Inter"], "headline-lg": ["Inter"], "display-lg": ["Inter"], "label-sm": ["Inter"], "label-md": ["Inter"], "body-md": ["Inter"], "body-lg": ["Inter"] },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
    <style>
        .shadow-ambient-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-ambient-2 { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
        .nav-link { position: relative; padding-bottom: 12px; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #003f87;
            border-radius: 1px 1px 0 0;
        }
    </style>
</HeadContent>
<div class="bg-background font-body-md text-on-surface min-h-screen flex flex-col">

    @if (showSuccessMessage)
    {
        <div class="fixed top-6 right-6 z-50 bg-tertiary-container text-on-tertiary-fixed px-6 py-3 rounded-xl shadow-ambient-2 flex items-center gap-3 animate-pulse">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span class="font-label-md">@successMessage</span>
        </div>
    }

    <nav class="bg-surface-container-lowest border-b border-outline-variant/30 sticky top-0 z-50">
        <div class="max-w-[1280px] mx-auto flex items-center justify-between px-6 py-3">
            <div class="flex items-center gap-8">
                <a href="/admin" class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                    <span class="text-headline-md font-headline-md font-bold text-primary">HumanityFlow</span>
                </a>
                <div class="hidden md:flex items-center gap-1">
                    <a href="/admin" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Overview</a>
                    <a href="/admin/campaigns" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Campaigns</a>
                    <a href="/admin/donations" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Donations</a>
                    <a href="/admin/applicants" class="nav-link active text-label-md font-label-md text-primary px-3 py-3">Applicants</a>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button class="relative p-2 rounded-lg hover:bg-surface-container transition-colors" title="Notifications">
                    <span class="material-symbols-outlined text-on-surface-variant text-[22px]" style="font-variation-settings: 'FILL' 0;">notifications</span>
                    <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full"></span>
                </button>
                <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center">
                    <span class="text-label-sm font-label-sm text-on-primary">AD</span>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        <div class="max-w-[1280px] mx-auto px-6 py-8">

            @if (isLoading)
            {
                <div class="flex items-center justify-center h-64">
                    <div class="flex flex-col items-center gap-4">
                        <div class="w-10 h-10 border-4 border-primary-fixed border-t-primary rounded-full animate-spin"></div>
                        <p class="text-on-surface-variant font-label-md text-label-md">Loading applications...</p>
                    </div>
                </div>
            }
            else
            {
                @if (selectedApplication == null)
                {
                    <div class="mb-6">
                        <h1 class="font-headline-lg text-headline-lg text-on-surface">Verification Queue</h1>
                        <p class="text-body-md font-body-md text-on-surface-variant mt-1">@applications.Count application(s) pending review</p>
                    </div>

                    @if (applications.Count == 0)
                    {
                        <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-12 text-center">
                            <span class="material-symbols-outlined text-[48px] text-outline-variant">inbox</span>
                            <p class="mt-4 font-label-md text-label-md text-on-surface-variant">No applications in queue</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3">
                            @foreach (var app in applications)
                            {
                                <button @onclick="() => SelectApplication(app)" class="w-full text-left bg-surface-container-lowest rounded-xl shadow-ambient-1 p-5 hover:shadow-ambient-2 transition-all border border-transparent hover:border-primary-fixed-dim group">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-4">
                                            <div class="w-11 h-11 rounded-full bg-primary-fixed flex items-center justify-center shrink-0">
                                                <span class="material-symbols-outlined text-[20px] text-primary">person</span>
                                            </div>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                     <p class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors">APP-@app.Id</p>
                                                     <span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-[#fef3c7] text-[#92400e]">@app.Status</span>
                                                 </div>
                                                <p class="text-body-md font-body-md text-on-surface mt-0.5">@(app.User?.Name ?? "Unknown")</p>
                                                <p class="text-label-sm font-label-sm text-on-surface-variant mt-0.5">@(app.Campaign?.Title ?? "Unknown Campaign")</p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <p class="font-label-md text-label-md text-on-surface">Rp @FormatCurrency(app.Amount)</p>
                                            <p class="text-label-sm font-label-sm text-on-surface-variant mt-1">@FormatDate(app.CreatedDate)</p>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- Left Column: Details -->
                        <div class="lg:col-span-8 flex flex-col gap-6">
                            <div class="flex items-center gap-3">
                                <button @onclick="BackToQueue" class="p-2 rounded-lg hover:bg-surface-container-high transition-colors text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                                </button>
                                <nav class="flex items-center gap-2 text-label-md font-label-md">
                                    <button @onclick="BackToQueue" class="text-on-surface-variant hover:text-primary transition-colors">Verification Queue</button>
                                    <span class="material-symbols-outlined text-[16px] text-outline-variant">chevron_right</span>
                                    <span class="text-on-surface">APP-@selectedApplication.Id</span>
                                </nav>
                            </div>

                            <div class="flex items-center gap-3">
                                <h1 class="font-headline-lg text-headline-lg text-on-surface">Application Verification</h1>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-sm bg-[#fef3c7] text-[#92400e]">
                                    <span class="material-symbols-outlined text-[14px] mr-1">priority_high</span>
                                    Urgent Priority
                                </span>
                            </div>

                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <h2 class="font-headline-md text-headline-md text-on-surface mb-4">Applicant Information</h2>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-5 gap-x-8">
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Organization / Name</p>
                                        <p class="text-body-md font-body-md text-on-surface">@(selectedApplication.User?.Name ?? "Unknown")</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Type</p>
                                        <p class="text-body-md font-body-md text-on-surface">Individual Donor</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Country</p>
                                        <p class="text-body-md font-body-md text-on-surface">Indonesia</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Requested Amount</p>
                                        <p class="text-body-md font-body-md text-on-surface font-semibold">Rp @FormatCurrency(selectedApplication.Amount)</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Duration</p>
                                        <p class="text-body-md font-body-md text-on-surface">One-time</p>
                                    </div>
                                    <div>
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Contact</p>
                                        <p class="text-body-md font-body-md text-on-surface">@(selectedApplication.User?.Email ?? "N/A")</p>
                                    </div>
                                </div>
                                <div class="mt-6 bg-surface-variant rounded-lg h-40 flex items-center justify-center">
                                    <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[36px]">location_on</span>
                                        <p class="text-label-sm font-label-sm">Location - Indonesia</p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Project Description</h2>
                                <h3 class="text-body-lg font-body-lg text-primary font-semibold mb-2">@(selectedApplication.Campaign?.Title ?? "Unknown Campaign")</h3>
                                <p class="text-body-md font-body-md text-on-surface-variant leading-relaxed mb-6">@(selectedApplication.Campaign?.Description ?? "No description available.")</p>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                    <div class="bg-surface-container rounded-xl p-4 text-center">
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Target Reach</p>
                                        <p class="font-headline-md text-headline-md text-on-surface">Rp @FormatCurrency(selectedApplication.Campaign?.TargetAmount ?? 0)</p>
                                    </div>
                                    <div class="bg-surface-container rounded-xl p-4 text-center">
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Cost / Capita</p>
                                        <p class="font-headline-md text-headline-md text-on-surface">Rp @FormatCurrency(selectedApplication.Amount)</p>
                                    </div>
                                    <div class="bg-surface-container rounded-xl p-4 text-center">
                                        <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Status</p>
                                        @if (selectedApplication.Campaign?.IsActive == true)
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed">
                                                <span class="material-symbols-outlined text-[14px] mr-1">check_circle</span>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-label-sm font-label-sm bg-surface-variant text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[14px] mr-1">cancel</span>
                                                Inactive
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <h2 class="font-headline-md text-headline-md text-on-surface mb-4">Supporting Documents</h2>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="flex items-center gap-4 bg-surface-container rounded-xl p-4">
                                        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-label-md text-label-md text-on-surface truncate">Organization_Registration.pdf</p>
                                            <p class="text-label-sm font-label-sm text-on-surface-variant">2.4 MB</p>
                                        </div>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed shrink-0">Verified</span>
                                    </div>
                                    <div class="flex items-center gap-4 bg-surface-container rounded-xl p-4">
                                        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-label-md text-label-md text-on-surface truncate">Financial_Statement_2025.xlsx</p>
                                            <p class="text-label-sm font-label-sm text-on-surface-variant">1.8 MB</p>
                                        </div>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed shrink-0">Verified</span>
                                    </div>
                                    <div class="flex items-center gap-4 bg-surface-container rounded-xl p-4">
                                        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-label-md text-label-md text-on-surface truncate">Project_Proposal.pdf</p>
                                            <p class="text-label-sm font-label-sm text-on-surface-variant">3.1 MB</p>
                                        </div>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-[#fef3c7] text-[#92400e] shrink-0">Under Review</span>
                                    </div>
                                    <div class="flex items-center gap-4 bg-surface-container rounded-xl p-4">
                                        <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[20px] text-primary">description</span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-label-md text-label-md text-on-surface truncate">Impact_Assessment.pdf</p>
                                            <p class="text-label-sm font-label-sm text-on-surface-variant">1.2 MB</p>
                                        </div>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-label-sm font-label-sm bg-surface-variant text-on-surface-variant shrink-0">Pending</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Final Decision & KYC/AML -->
                        <div class="lg:col-span-4 flex flex-col gap-6">
                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Final Decision</h3>
                                <button @onclick="ApproveApplication" class="w-full bg-tertiary-container text-on-tertiary hover:opacity-90 rounded-lg py-3 flex items-center justify-center gap-2 font-label-md text-label-md transition-opacity mb-3">
                                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                                    Approve Application
                                </button>
                                <button @onclick="RejectApplication" class="w-full border-2 border-error text-error hover:bg-error-container rounded-lg py-3 flex items-center justify-center gap-2 font-label-md text-label-md transition-colors mb-4">
                                    <span class="material-symbols-outlined text-[20px]">cancel</span>
                                    Reject Application
                                </button>
                                <div class="flex items-center gap-4 mb-4">
                                    <hr class="flex-1 border-outline-variant/30"/>
                                    <span class="text-label-sm font-label-sm text-on-surface-variant">OR</span>
                                    <hr class="flex-1 border-outline-variant/30"/>
                                </div>
                                <p class="text-label-md font-label-md text-on-surface mb-2">Request Data Revision</p>
                                <textarea @bind="revisionNotes" rows="4" placeholder="Enter revision notes..." class="w-full rounded-lg border border-outline-variant/50 bg-surface-container p-3 text-body-md font-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary resize-none mb-3"></textarea>
                                <button @onclick="SendRevisionRequest" class="w-full bg-primary text-on-primary rounded-lg py-2.5 font-label-md text-label-md hover:opacity-90 transition-opacity">
                                    Send Revision Request
                                </button>
                            </div>

                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-label-md text-label-md text-on-surface">KYC/AML Compliance</h3>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed">Passed</span>
                                </div>
                                <div class="flex flex-col gap-3">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[20px] text-tertiary">check_circle</span>
                                        <span class="text-body-md font-body-md text-on-surface">Identity Verified</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[20px] text-tertiary">check_circle</span>
                                        <span class="text-body-md font-body-md text-on-surface">Sanctions Screening Clear</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[20px] text-tertiary">check_circle</span>
                                        <span class="text-body-md font-body-md text-on-surface">PEP Check Negative</span>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="font-label-md text-label-md text-on-surface">AI Fraud Detection</h3>
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-tertiary-fixed text-on-tertiary-fixed">Low Risk</span>
                                </div>
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-label-sm font-label-sm text-on-surface-variant">Risk Score</span>
                                    <span class="font-headline-md text-headline-md text-tertiary">12%</span>
                                </div>
                                <div class="w-full bg-surface-variant rounded-full h-2 mb-5">
                                    <div class="bg-tertiary rounded-full h-2" style="width: 12%"></div>
                                </div>
                                <p class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-3">Key Indicators</p>
                                <div class="flex flex-col gap-3">
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[18px] text-tertiary">check_circle</span>
                                        <span class="text-label-md font-label-md text-on-surface">Transaction Pattern Normal</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[18px] text-tertiary">check_circle</span>
                                        <span class="text-label-md font-label-md text-on-surface">Device Fingerprint Valid</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[18px] text-tertiary">check_circle</span>
                                        <span class="text-label-md font-label-md text-on-surface">Behavioral Analysis Clean</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    </main>

    <footer class="bg-surface-container-lowest border-t border-outline-variant/30 py-4">
        <p class="text-center text-label-sm font-label-sm text-on-surface-variant">&copy; 2026 HumanityFlow. Admin Panel v2.1</p>
    </footer>

</div>

@code {
    private List<DonationModel> applications = new();
    private DonationModel? selectedApplication;
    private bool isLoading = true;
    private string revisionNotes = "";
    private bool showSuccessMessage = false;
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await ApiService.GetAllDonationsAsync();
            applications = all.Where(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch
        {
            applications = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectApplication(DonationModel app)
    {
        selectedApplication = app;
    }

    private void BackToQueue()
    {
        selectedApplication = null;
    }

    private async Task ApproveApplication()
    {
        if (selectedApplication != null)
        {
            var success = await ApiService.UpdateDonationStatusAsync(selectedApplication.Id, "verified");
            if (success)
            {
                showSuccessMessage = true;
                successMessage = "Application approved successfully";
                var all = await ApiService.GetAllDonationsAsync();
                applications = all.Where(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
                BackToQueue();
                StateHasChanged();
                await Task.Delay(3000);
                showSuccessMessage = false;
                StateHasChanged();
            }
        }
    }

    private async Task RejectApplication()
    {
        if (selectedApplication != null)
        {
            var success = await ApiService.UpdateDonationStatusAsync(selectedApplication.Id, "rejected");
            if (success)
            {
                showSuccessMessage = true;
                successMessage = "Application rejected";
                var all = await ApiService.GetAllDonationsAsync();
                applications = all.Where(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
                BackToQueue();
                StateHasChanged();
                await Task.Delay(3000);
                showSuccessMessage = false;
                StateHasChanged();
            }
        }
    }

    private async Task SendRevisionRequest()
    {
        if (selectedApplication != null)
        {
            var success = await ApiService.UpdateDonationStatusAsync(selectedApplication.Id, "revision_requested");
            if (success)
            {
                var appName = selectedApplication.User?.Name ?? $"APP-{selectedApplication.Id}";
                showSuccessMessage = true;
                successMessage = $"Revision request sent to {appName}";
                revisionNotes = "";
                
                var all = await ApiService.GetAllDonationsAsync();
                applications = all.Where(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)).ToList();
                BackToQueue();
                
                StateHasChanged();
                await Task.Delay(3000);
                showSuccessMessage = false;
                StateHasChanged();
            }
        }
    }

    private string FormatCurrency(decimal amount)
    {
        return amount.ToString("N0");
    }

    private string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return date.ToString("dd MMM yyyy");
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("dd MMM yyyy");
    }
}
