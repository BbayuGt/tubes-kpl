@page "/admin"
@rendermode InteractiveServer
@using tubes_kpl.Services
@inject AdminApiService ApiService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<HeadContent>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <title>Admin Dashboard - @Config["AppName"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
    <style>
        .shadow-ambient-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-ambient-2 { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
        .bar-chart-bar { transition: height 0.3s ease; }
        .nav-link { position: relative; padding-bottom: 12px; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #003f87;
            border-radius: 1px 1px 0 0;
        }
        .stat-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
        .skeleton { background: linear-gradient(90deg, #e0e9f2 25%, #ecf5fe 50%, #e0e9f2 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
        @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
        .activity-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    </style>
</HeadContent>
<div class="bg-background min-h-screen flex flex-col font-body-md text-on-surface antialiased">

<nav class="bg-surface-container-lowest border-b border-outline-variant/30 sticky top-0 z-50">
    <div class="max-w-[1280px] mx-auto flex items-center justify-between px-6 py-3">
        
        <div class="flex items-center gap-8">
            <a href="/admin" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                <span class="text-headline-md font-headline-md font-bold text-primary">@Config["AppName"]</span>
            </a>
            <div class="hidden md:flex items-center gap-1">
                <a href="/admin" class="nav-link active text-label-md font-label-md text-primary px-3 py-3">Overview</a>
                <a href="/admin/campaigns" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Campaigns</a>
                <a href="/admin/donations" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Donations</a>
                <a href="/admin/users" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Users</a>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="hidden lg:flex items-center bg-surface-container rounded-lg px-3 py-2 gap-2 border border-outline-variant/30">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]" style="font-variation-settings: 'FILL' 0;">search</span>
                <input type="text" placeholder="Search..." class="bg-transparent border-none outline-none text-body-md text-on-surface w-48 placeholder:text-on-surface-variant/60" />
            </div>
            <button class="relative p-2 rounded-lg hover:bg-surface-container transition-colors" title="Notifications">
                <span class="material-symbols-outlined text-on-surface-variant text-[22px]" style="font-variation-settings: 'FILL' 0;">notifications</span>
                @if (pendingVerifications > 0)
                {
                    <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full"></span>
                }
            </button>
            <button @onclick="ConfirmLogout" class="relative p-2 rounded-lg hover:bg-red-50 text-error transition-colors" title="Logout">
                <span class="material-symbols-outlined text-[22px]">logout</span>
            </button>
            <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center">
                <span class="text-label-sm font-label-sm text-on-primary">AD</span>
            </div>
        </div>
    </div>
</nav>

<main class="flex-grow">
    <div class="max-w-[1280px] mx-auto px-6 py-8">

        @if (isLoading)
        {
            
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="skeleton h-8 w-48 rounded-lg mb-2"></div>
                        <div class="skeleton h-5 w-72 rounded"></div>
                    </div>
                    <div class="flex gap-3">
                        <div class="skeleton h-10 w-28 rounded-lg"></div>
                        <div class="skeleton h-10 w-36 rounded-lg"></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton h-32 rounded-xl"></div>
                    }
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-7 skeleton h-96 rounded-xl"></div>
                    <div class="lg:col-span-5 skeleton h-96 rounded-xl"></div>
                </div>
            </div>
        }
        else
        {
            
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-8 gap-4">
                <div>
                    <h1 class="text-headline-lg font-headline-lg text-on-surface">System Overview</h1>
                    <p class="text-body-md text-on-surface-variant mt-1">Monitor campaigns, donations, and verification status in real time.</p>
                </div>
                <div class="flex items-center gap-3">
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant/50 text-label-md font-label-md text-on-surface-variant hover:bg-surface-container transition-colors">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 0;">download</span>
                        Export Data
                    </button>
                    <a href="/admin/campaigns" class="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary text-on-primary text-label-md font-label-md hover:bg-primary-container transition-colors shadow-sm">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 0;">add</span>
                        New Campaign
                    </a>
                </div>
            </div>

            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                
                <div class="stat-card bg-surface-container-lowest rounded-xl shadow-ambient-1 p-5 border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-primary-fixed/40 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-[22px]" style="font-variation-settings: 'FILL' 0;">payments</span>
                        </div>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-tertiary-fixed/30 text-tertiary text-label-sm font-label-sm">
                            <span class="material-symbols-outlined text-[14px]">trending_up</span>
                            +12.5%
                        </span>
                    </div>
                    <p class="text-label-md font-label-md text-on-surface-variant mb-1">Total Donations</p>
                    <p class="text-headline-md font-headline-md text-on-surface">@FormatCurrency(totalDonations)</p>
                </div>

                
                <div class="stat-card bg-surface-container-lowest rounded-xl shadow-ambient-1 p-5 border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-primary-fixed/40 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary text-[22px]" style="font-variation-settings: 'FILL' 0;">campaign</span>
                        </div>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary-fixed/30 text-primary text-label-sm font-label-sm">
                            @activeCampaigns Active
                        </span>
                    </div>
                    <p class="text-label-md font-label-md text-on-surface-variant mb-1">Active Campaigns</p>
                    <p class="text-headline-md font-headline-md text-on-surface">@campaigns.Count</p>
                </div>

                
                <div class="stat-card bg-surface-container-lowest rounded-xl shadow-ambient-1 p-5 border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-error-container/40 flex items-center justify-center">
                            <span class="material-symbols-outlined text-error text-[22px]" style="font-variation-settings: 'FILL' 0;">verified_user</span>
                        </div>
                        @if (pendingVerifications > 0)
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-error-container/50 text-error text-label-sm font-label-sm">
                                <span class="material-symbols-outlined text-[14px]">priority_high</span>
                                Urgent: @pendingVerifications
                            </span>
                        }
                    </div>
                    <p class="text-label-md font-label-md text-on-surface-variant mb-1">Pending Verifications</p>
                    <p class="text-headline-md font-headline-md text-on-surface">@pendingVerifications</p>
                </div>

                
                <div class="stat-card bg-surface-container-lowest rounded-xl shadow-ambient-1 p-5 border border-outline-variant/20">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-tertiary-fixed/40 flex items-center justify-center">
                            <span class="material-symbols-outlined text-tertiary text-[22px]" style="font-variation-settings: 'FILL' 0;">trending_up</span>
                        </div>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-tertiary-fixed/30 text-tertiary text-label-sm font-label-sm">
                            Target Met
                        </span>
                    </div>
                    <p class="text-label-md font-label-md text-on-surface-variant mb-1">Successful Impacts</p>
                    <p class="text-headline-md font-headline-md text-on-surface">12.4k</p>
                </div>
            </div>

            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                
                <div class="lg:col-span-7 space-y-6">

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 overflow-hidden">
                        <div class="flex items-center justify-between px-5 py-4 border-b border-outline-variant/20">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">fact_check</span>
                                <h2 class="text-label-md font-label-md text-on-surface font-semibold">Pending Verifications</h2>
                                @if (pendingVerifications > 0)
                                {
                                    <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-error text-on-error text-label-sm font-label-sm">@pendingVerifications</span>
                                }
                            </div>
                            <a href="/admin/donations" class="text-label-md font-label-md text-primary hover:text-primary-container transition-colors">View All</a>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="bg-surface-container/50">
                                        <th class="text-left text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Donor</th>
                                        <th class="text-left text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Campaign</th>
                                        <th class="text-right text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Amount</th>
                                        <th class="text-left text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Date</th>
                                        <th class="text-center text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/15">
                                    @if (donations.Any())
                                    {
                                        @foreach (var donation in donations.Take(5))
                                        {
                                            <tr class="hover:bg-surface-container/30 transition-colors">
                                                <td class="px-5 py-3.5">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-8 h-8 rounded-full bg-primary-fixed/50 flex items-center justify-center flex-shrink-0">
                                                            <span class="text-label-sm font-label-sm text-primary">@GetInitials(donation.User?.Name ?? "U")</span>
                                                        </div>
                                                        <div>
                                                            <p class="text-label-md font-label-md text-on-surface">@(donation.User?.Name ?? "Anonymous")</p>
                                                            <p class="text-label-sm text-on-surface-variant">REF-@donation.Id.ToString("D5")</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-5 py-3.5">
                                                    <p class="text-body-md text-on-surface truncate max-w-[160px]">@(donation.Campaign?.Title ?? "General Fund")</p>
                                                </td>
                                                <td class="px-5 py-3.5 text-right">
                                                    <p class="text-label-md font-label-md text-on-surface">@FormatCurrency(donation.Amount)</p>
                                                </td>
                                                <td class="px-5 py-3.5">
                                                    <p class="text-body-md text-on-surface-variant">@donation.CreatedDate.ToString("dd MMM yyyy")</p>
                                                </td>
                                                <td class="px-5 py-3.5 text-center">
                                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-amber-100 text-amber-700">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                                        Pending
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="px-5 py-12 text-center">
                                                <span class="material-symbols-outlined text-on-surface-variant/40 text-[40px] mb-2 block" style="font-variation-settings: 'FILL' 0;">inbox</span>
                                                <p class="text-body-md text-on-surface-variant">No pending verifications</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-5">
                        <div class="flex items-center justify-between mb-5">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">bar_chart</span>
                                <h2 class="text-label-md font-label-md text-on-surface font-semibold">Donation Flux</h2>
                            </div>
                            <div class="flex items-center gap-4 text-label-sm text-on-surface-variant">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-3 h-3 rounded-sm bg-primary"></span>
                                    This Month
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="w-3 h-3 rounded-sm bg-primary-fixed-dim"></span>
                                    Last Month
                                </div>
                            </div>
                        </div>
                        <div class="flex items-end justify-between gap-2 h-40">
                            @foreach (var bar in chartData)
                            {
                                <div class="flex-1 flex flex-col items-center gap-1">
                                    <div class="w-full flex gap-0.5 items-end justify-center" style="height: 120px;">
                                        <div class="bar-chart-bar w-3 rounded-t bg-primary-fixed-dim" style="height: @(bar.PrevHeight)px;"></div>
                                        <div class="bar-chart-bar w-3 rounded-t bg-primary" style="height: @(bar.CurrHeight)px;"></div>
                                    </div>
                                    <span class="text-label-sm text-on-surface-variant">@bar.Label</span>
                                </div>
                            }
                        </div>
                    </div>

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-5">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">query_stats</span>
                            <h2 class="text-label-md font-label-md text-on-surface font-semibold">Verification Backlog</h2>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-label-md font-label-md text-on-surface">Identity Verification</span>
                                    <span class="text-label-sm text-on-surface-variant">78%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-surface-container-high">
                                    <div class="h-2 rounded-full bg-primary transition-all" style="width: 78%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-label-md font-label-md text-on-surface">Payment Confirmation</span>
                                    <span class="text-label-sm text-on-surface-variant">92%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-surface-container-high">
                                    <div class="h-2 rounded-full bg-tertiary transition-all" style="width: 92%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-label-md font-label-md text-on-surface">Document Review</span>
                                    <span class="text-label-sm text-on-surface-variant">45%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-surface-container-high">
                                    <div class="h-2 rounded-full bg-amber-500 transition-all" style="width: 45%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <span class="text-label-md font-label-md text-on-surface">Impact Assessment</span>
                                    <span class="text-label-sm text-on-surface-variant">63%</span>
                                </div>
                                <div class="w-full h-2 rounded-full bg-surface-container-high">
                                    <div class="h-2 rounded-full bg-primary-container transition-all" style="width: 63%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                
                <div class="lg:col-span-5 space-y-6">

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-5">
                        <div class="flex items-center justify-between mb-5">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">history</span>
                                <h2 class="text-label-md font-label-md text-on-surface font-semibold">Recent Activity</h2>
                            </div>
                            <button class="text-label-sm text-primary hover:text-primary-container transition-colors">View All</button>
                        </div>
                        <div class="space-y-0">
                            @foreach (var activity in recentActivities)
                            {
                                <div class="flex items-start gap-3 py-3 border-b border-outline-variant/10 last:border-b-0">
                                    <div class="activity-dot mt-2 @activity.DotColor"></div>
                                    <div class="flex-grow min-w-0">
                                        <p class="text-label-md font-label-md text-on-surface">@activity.Title</p>
                                        <p class="text-label-sm text-on-surface-variant mt-0.5 truncate">@activity.Description</p>
                                    </div>
                                    <span class="text-label-sm text-on-surface-variant whitespace-nowrap flex-shrink-0">@activity.Time</span>
                                </div>
                            }
                        </div>
                    </div>

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-5">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">category</span>
                            <h2 class="text-label-md font-label-md text-on-surface font-semibold">Active Categories</h2>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var cat in activeCategories)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-label-md font-label-md @cat.Bg @cat.Text border @cat.Border">
                                    <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 0;">@cat.Icon</span>
                                    @cat.Name
                                    <span class="text-label-sm opacity-70">(@cat.Count)</span>
                                </span>
                            }
                        </div>
                    </div>

                    
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-5">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">workspace_premium</span>
                                <h2 class="text-label-md font-label-md text-on-surface font-semibold">Top Campaigns</h2>
                            </div>
                            <a href="/admin/campaigns" class="text-label-sm text-primary hover:text-primary-container transition-colors">See All</a>
                        </div>
                        <div class="space-y-3">
                            @if (campaigns.Any())
                            {
                                @foreach (var campaign in campaigns.Take(4))
                                {
                                    var progress = campaign.TargetAmount > 0 ? (int)((campaign.CollectedAmount / campaign.TargetAmount) * 100) : 0;
                                    <div class="flex items-center gap-3 p-3 rounded-lg hover:bg-surface-container/40 transition-colors">
                                        <div class="w-10 h-10 rounded-lg bg-primary-fixed/30 flex items-center justify-center flex-shrink-0">
                                            <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">favorite</span>
                                        </div>
                                        <div class="flex-grow min-w-0">
                                            <p class="text-label-md font-label-md text-on-surface truncate">@campaign.Title</p>
                                            <div class="flex items-center gap-2 mt-1">
                                                <div class="flex-grow h-1.5 rounded-full bg-surface-container-high">
                                                    <div class="h-1.5 rounded-full bg-primary transition-all" style="width: @(Math.Min(progress, 100))%;"></div>
                                                </div>
                                                <span class="text-label-sm text-on-surface-variant flex-shrink-0">@progress%</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-6">
                                    <span class="material-symbols-outlined text-on-surface-variant/40 text-[32px] mb-1 block" style="font-variation-settings: 'FILL' 0;">folder_open</span>
                                    <p class="text-body-md text-on-surface-variant">No campaigns yet</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</main>

<footer class="border-t border-outline-variant/20 mt-auto">
    <div class="max-w-[1280px] mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-label-sm font-label-sm text-on-surface-variant opacity-60">© 2026 @Config["AppName"]. All rights reserved.</p>
        <div class="flex items-center gap-4">
            <a href="#" class="text-label-sm text-on-surface-variant hover:text-primary transition-colors">Privacy Policy</a>
            <a href="#" class="text-label-sm text-on-surface-variant hover:text-primary transition-colors">Terms of Service</a>
            <a href="#" class="text-label-sm text-on-surface-variant hover:text-primary transition-colors">Support</a>
        </div>
    </div>
</footer>

</div>

@code {
    private List<CampaignModel> campaigns = new();
    private List<DonationModel> donations = new();
    private bool isLoading = true;

    private decimal totalDonations = 0;
    private int activeCampaigns = 0;
    private int pendingVerifications = 0;

    private List<ChartBar> chartData = new();
    private List<ActivityItem> recentActivities = new();
    private List<CategoryChip> activeCategories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var campaignsTask = ApiService.GetAllCampaignsAsync();
            var donationsTask = ApiService.GetAllDonationsAsync();

            await Task.WhenAll(campaignsTask, donationsTask);

            campaigns = await campaignsTask;
            donations = await donationsTask;

            totalDonations = donations.Where(d => d.Status.Equals("verified", StringComparison.OrdinalIgnoreCase)).Sum(d => d.Amount);
            activeCampaigns = campaigns.Count(c => c.IsActive);
            pendingVerifications = donations.Count(d => d.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));

            GenerateChartData();
            GenerateRecentActivities();
            GenerateActiveCategories();
        }
        catch
        {
            campaigns = new List<CampaignModel>();
            donations = new List<DonationModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GenerateChartData()
    {
        var labels = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
        var random = new Random(42);
        chartData = labels.Select(label => new ChartBar
        {
            Label = label,
            CurrHeight = random.Next(30, 110),
            PrevHeight = random.Next(20, 80)
        }).ToList();
    }

    private void GenerateRecentActivities()
    {
        recentActivities = new List<ActivityItem>();

        foreach (var donation in donations.Take(3))
        {
            recentActivities.Add(new ActivityItem
            {
                Title = $"New donation received",
                Description = $"{donation.User?.Name ?? "Anonymous"} donated {FormatCurrency(donation.Amount)}",
                Time = GetTimeAgo(donation.CreatedDate),
                DotColor = "bg-primary"
            });
        }

        foreach (var campaign in campaigns.Take(2))
        {
            recentActivities.Add(new ActivityItem
            {
                Title = "Campaign updated",
                Description = $"\"{campaign.Title}\" - {FormatCurrency(campaign.CollectedAmount)} collected",
                Time = GetTimeAgo(campaign.CreatedAt),
                DotColor = "bg-tertiary"
            });
        }

        if (!recentActivities.Any())
        {
            recentActivities.Add(new ActivityItem
            {
                Title = "System initialized",
                Description = "Admin dashboard is ready to use",
                Time = "Just now",
                DotColor = "bg-primary"
            });
            recentActivities.Add(new ActivityItem
            {
                Title = "Monitoring active",
                Description = "All systems are operational",
                Time = "1m ago",
                DotColor = "bg-tertiary"
            });
        }

        recentActivities = recentActivities.Take(5).ToList();
    }

    private void GenerateActiveCategories()
    {
        activeCategories = new List<CategoryChip>
        {
            new() { Name = "Healthcare", Icon = "health_and_safety", Count = campaigns.Count(c => c.Title.Contains("Health", StringComparison.OrdinalIgnoreCase) || c.Title.Contains("Medical", StringComparison.OrdinalIgnoreCase)) + 3, Bg = "bg-red-50", Text = "text-red-700", Border = "border-red-200" },
            new() { Name = "Education", Icon = "school", Count = campaigns.Count(c => c.Title.Contains("Edu", StringComparison.OrdinalIgnoreCase) || c.Title.Contains("School", StringComparison.OrdinalIgnoreCase)) + 5, Bg = "bg-blue-50", Text = "text-blue-700", Border = "border-blue-200" },
            new() { Name = "Disaster Relief", Icon = "emergency_home", Count = 2, Bg = "bg-amber-50", Text = "text-amber-700", Border = "border-amber-200" },
            new() { Name = "Environment", Icon = "eco", Count = 4, Bg = "bg-emerald-50", Text = "text-emerald-700", Border = "border-emerald-200" },
            new() { Name = "Community", Icon = "groups", Count = campaigns.Count > 0 ? campaigns.Count : 6, Bg = "bg-purple-50", Text = "text-purple-700", Border = "border-purple-200" },
            new() { Name = "Food Security", Icon = "restaurant", Count = 3, Bg = "bg-orange-50", Text = "text-orange-700", Border = "border-orange-200" }
        };
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000)
            return $"Rp {amount / 1_000_000:N1}M";
        if (amount >= 1_000)
            return $"Rp {amount / 1_000:N0}K";
        return $"Rp {amount:N0}";
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var diff = DateTime.Now - dateTime;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dateTime.ToString("dd MMM");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts[0][0].ToString().ToUpper();
    }

    private class ChartBar
    {
        public string Label { get; set; } = "";
        public int CurrHeight { get; set; }
        public int PrevHeight { get; set; }
    }

    private class ActivityItem
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Time { get; set; } = "";
        public string DotColor { get; set; } = "bg-primary";
    }

    private class CategoryChip
    {
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
        public int Count { get; set; }
        public string Bg { get; set; } = "";
        public string Text { get; set; } = "";
        public string Border { get; set; } = "";
    }

    private async Task ConfirmLogout()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to logout?");
        if (confirmed)
        {
            NavigationManager.NavigateTo("/logout", true);
        }
    }
}
