                                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 0;">check</span>
                                            Approve
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-surface-container/40 border border-outline-variant/20">
                                        <span class="material-symbols-outlined text-on-surface-variant text-[18px]" style="font-variation-settings: 'FILL' 0;">info</span>
