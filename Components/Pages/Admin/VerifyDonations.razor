                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        
                        <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 p-8 flex flex-col items-center justify-center min-h-[400px]">
                            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-on-surface-variant/50 text-[32px]" style="font-variation-settings: 'FILL' 0;">touch_app</span>
                            </div>
                            <h3 class="text-label-md font-label-md text-on-surface font-semibold mb-1">Select a Donation</h3>
                            <p class="text-body-md text-on-surface-variant text-center max-w-[240px]">Click on any donation from the table to view details and take action.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</main>

