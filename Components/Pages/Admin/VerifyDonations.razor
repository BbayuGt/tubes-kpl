@page "/admin/donations"
@rendermode InteractiveServer
@using tubes_kpl.Services
@inject AdminApiService ApiService

<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <title>Verify Donations - HumanityFlow</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
    <style>
        .shadow-ambient-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-ambient-2 { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
        .nav-link { position: relative; padding-bottom: 12px; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #003f87;
            border-radius: 1px 1px 0 0;
        }
        .tab-btn { position: relative; padding-bottom: 8px; transition: color 0.2s ease; }
        .tab-btn.active { color: #003f87; }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #003f87;
            border-radius: 1px 1px 0 0;
        }
        .donation-row { transition: background-color 0.15s ease; cursor: pointer; }
        .donation-row:hover { background-color: rgba(230, 239, 248, 0.5); }
        .donation-row.selected { background-color: rgba(215, 226, 255, 0.35); border-left: 3px solid #003f87; }
        .skeleton { background: linear-gradient(90deg, #e0e9f2 25%, #ecf5fe 50%, #e0e9f2 75%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
        @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
        .detail-panel { transition: opacity 0.2s ease, transform 0.2s ease; }
        .toast-notification {
            animation: slideInRight 0.3s ease forwards;
        }
        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }
    </style>
</head>
<body class="bg-background min-h-screen flex flex-col font-body-md text-on-surface antialiased">

<nav class="bg-surface-container-lowest border-b border-outline-variant/30 sticky top-0 z-50">
    <div class="max-w-[1280px] mx-auto flex items-center justify-between px-6 py-3">
        
        <div class="flex items-center gap-8">
            <a href="/admin" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                <span class="text-headline-md font-headline-md font-bold text-primary">HumanityFlow</span>
            </a>
            <div class="hidden md:flex items-center gap-1">
                <a href="/admin" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Overview</a>
                <a href="/admin/campaigns" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Campaigns</a>
                <a href="/admin/donations" class="nav-link active text-label-md font-label-md text-primary px-3 py-3">Donations</a>
                <a href="/admin/applicants" class="nav-link text-label-md font-label-md text-on-surface-variant hover:text-primary px-3 py-3 transition-colors">Applicants</a>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="hidden lg:flex items-center bg-surface-container rounded-lg px-3 py-2 gap-2 border border-outline-variant/30">
                <span class="material-symbols-outlined text-on-surface-variant text-[20px]" style="font-variation-settings: 'FILL' 0;">search</span>
                <input type="text" placeholder="Search donations..." @bind="searchQuery" @bind:event="oninput" @onkeyup="ApplyFilter" class="bg-transparent border-none outline-none text-body-md text-on-surface w-48 placeholder:text-on-surface-variant/60" />
            </div>
            <button class="relative p-2 rounded-lg hover:bg-surface-container transition-colors" title="Notifications">
                <span class="material-symbols-outlined text-on-surface-variant text-[22px]" style="font-variation-settings: 'FILL' 0;">notifications</span>
                @if (pendingCount > 0)
                {
                    <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full"></span>
                }
            </button>
            <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center">
                <span class="text-label-sm font-label-sm text-on-primary">AD</span>
            </div>
        </div>
    </div>
</nav>

@if (showToast)
{
    <div class="fixed top-20 right-6 z-[100] toast-notification">
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl shadow-ambient-2 border @(toastType == "success" ? "bg-emerald-50 border-emerald-200" : "bg-red-50 border-red-200")">
            <span class="material-symbols-outlined text-[20px] @(toastType == "success" ? "text-emerald-600" : "text-red-600")" style="font-variation-settings: 'FILL' 1;">
                @(toastType == "success" ? "check_circle" : "error")
            </span>
            <p class="text-label-md font-label-md @(toastType == "success" ? "text-emerald-800" : "text-red-800")">@toastMessage</p>
            <button @onclick="() => showToast = false" class="ml-2 p-0.5 rounded hover:bg-black/5 transition-colors">
                <span class="material-symbols-outlined text-[16px] text-on-surface-variant">close</span>
            </button>
        </div>
    </div>
}

<main class="flex-grow">
    <div class="max-w-[1280px] mx-auto px-6 py-8">

        @if (isLoading)
        {
            
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <div class="skeleton h-8 w-56 rounded-lg"></div>
                    <div class="skeleton h-10 w-32 rounded-lg"></div>
                </div>
                <div class="flex gap-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="skeleton h-9 w-28 rounded-lg"></div>
                    }
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-7 skeleton h-[500px] rounded-xl"></div>
                    <div class="lg:col-span-5 skeleton h-[500px] rounded-xl"></div>
                </div>
            </div>
        }
        else
        {
            
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 gap-4">
                <div class="flex items-center gap-3">
                    <h1 class="text-headline-lg font-headline-lg text-on-surface">Verification Queue</h1>
                    @if (pendingCount > 0)
                    {
                        <span class="inline-flex items-center px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-label-md font-label-md">
                            @pendingCount pending
                        </span>
                    }
                </div>
                <div class="flex items-center gap-3">
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant/50 text-label-md font-label-md text-on-surface-variant hover:bg-surface-container transition-colors">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 0;">filter_list</span>
                        Filters
                    </button>
                    <button class="flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline-variant/50 text-label-md font-label-md text-on-surface-variant hover:bg-surface-container transition-colors">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 0;">download</span>
                        Export
                    </button>
                </div>
            </div>

            
            <div class="flex items-center gap-1 border-b border-outline-variant/20 mb-6">
                <button @onclick='() => SetFilter("all")' class="tab-btn @(activeFilter == "all" ? "active" : "") text-label-md font-label-md px-4 py-2.5 @(activeFilter == "all" ? "text-primary" : "text-on-surface-variant hover:text-on-surface") transition-colors">
                    All Recent
                    <span class="ml-1 text-label-sm opacity-70">(@allDonations.Count)</span>
                </button>
                <button @onclick='() => SetFilter("pending")' class="tab-btn @(activeFilter == "pending" ? "active" : "") text-label-md font-label-md px-4 py-2.5 @(activeFilter == "pending" ? "text-primary" : "text-on-surface-variant hover:text-on-surface") transition-colors">
                    Pending Only
                    <span class="ml-1 text-label-sm opacity-70">(@pendingCount)</span>
                </button>
                <button @onclick='() => SetFilter("verified")' class="tab-btn @(activeFilter == "verified" ? "active" : "") text-label-md font-label-md px-4 py-2.5 @(activeFilter == "verified" ? "text-primary" : "text-on-surface-variant hover:text-on-surface") transition-colors">
                    Verified
                    <span class="ml-1 text-label-sm opacity-70">(@verifiedCount)</span>
                </button>
                <button @onclick='() => SetFilter("rejected")' class="tab-btn @(activeFilter == "rejected" ? "active" : "") text-label-md font-label-md px-4 py-2.5 @(activeFilter == "rejected" ? "text-primary" : "text-on-surface-variant hover:text-on-surface") transition-colors">
                    Rejected
                    <span class="ml-1 text-label-sm opacity-70">(@rejectedCount)</span>
                </button>
            </div>

            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                
                <div class="lg:col-span-7">
                    <div class="bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="bg-surface-container/50">
                                        <th class="text-left text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Donor</th>
                                        <th class="text-right text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Amount</th>
                                        <th class="text-left text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Date</th>
                                        <th class="text-center text-label-sm font-label-sm text-on-surface-variant px-5 py-3 uppercase tracking-wider">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/15">
                                    @if (filteredDonations.Any())
                                    {
                                        @foreach (var donation in filteredDonations)
                                        {
                                            var isSelected = selectedDonation?.Id == donation.Id;
                                            var status = GetDonationStatus(donation.Id);
                                            <tr class="donation-row @(isSelected ? "selected" : "")" @onclick="() => SelectDonation(donation)">
                                                <td class="px-5 py-3.5">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-9 h-9 rounded-full bg-primary-fixed/50 flex items-center justify-center flex-shrink-0">
                                                            <span class="text-label-sm font-label-sm text-primary">@GetInitials(donation.User?.Name ?? "U")</span>
                                                        </div>
                                                        <div>
                                                            <p class="text-label-md font-label-md text-on-surface">@(donation.User?.Name ?? "Anonymous")</p>
                                                            <p class="text-label-sm text-on-surface-variant">REF-@donation.Id.ToString("D5")</p>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-5 py-3.5 text-right">
                                                    <p class="text-label-md font-label-md text-on-surface">@FormatCurrency(donation.Amount)</p>
                                                </td>
                                                <td class="px-5 py-3.5">
                                                    <p class="text-body-md text-on-surface-variant">@donation.CreatedDate.ToString("dd MMM yyyy")</p>
                                                    <p class="text-label-sm text-on-surface-variant/70">@donation.CreatedDate.ToString("HH:mm")</p>
                                                </td>
                                                <td class="px-5 py-3.5 text-center">
                                                    @if (status == "verified")
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-emerald-100 text-emerald-700">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                                                            Verified
                                                        </span>
                                                    }
                                                    else if (status == "rejected")
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-red-100 text-red-700">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                                                            Rejected
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-label-sm font-label-sm bg-amber-100 text-amber-700">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 mr-1.5"></span>
                                                            Pending
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="px-5 py-16 text-center">
                                                <span class="material-symbols-outlined text-on-surface-variant/40 text-[48px] mb-3 block" style="font-variation-settings: 'FILL' 0;">inbox</span>
                                                <p class="text-body-lg text-on-surface-variant font-medium mb-1">No donations found</p>
                                                <p class="text-body-md text-on-surface-variant/70">Try adjusting your filters or check back later.</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @if (filteredDonations.Any())
                        {
                            <div class="flex items-center justify-between px-5 py-3 bg-surface-container/30 border-t border-outline-variant/15">
                                <p class="text-label-sm text-on-surface-variant">Showing @filteredDonations.Count of @allDonations.Count donations</p>
                                <div class="flex items-center gap-1">
                                    <button class="p-1.5 rounded hover:bg-surface-container transition-colors" disabled>
                                        <span class="material-symbols-outlined text-on-surface-variant/50 text-[18px]">chevron_left</span>
                                    </button>
                                    <span class="px-3 py-1 rounded bg-primary text-on-primary text-label-sm font-label-sm">1</span>
                                    <button class="p-1.5 rounded hover:bg-surface-container transition-colors">
                                        <span class="material-symbols-outlined text-on-surface-variant text-[18px]">chevron_right</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                
                <div class="lg:col-span-5">
                    @if (selectedDonation != null)
                    {
                        var selStatus = GetDonationStatus(selectedDonation.Id);
                        <div class="detail-panel bg-surface-container-lowest rounded-xl shadow-ambient-1 border border-outline-variant/20 overflow-hidden">
                            
                            <div class="px-5 py-4 border-b border-outline-variant/15 bg-surface-container/30">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        @if (selStatus == "verified")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-label-md font-label-md">
                                                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                                                VERIFIED
                                            </span>
                                        }
                                        else if (selStatus == "rejected")
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 text-red-700 text-label-md font-label-md">
                                                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">cancel</span>
                                                REJECTED
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-700 text-label-md font-label-md">
                                                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 0;">hourglass_top</span>
                                                PENDING VERIFICATION
                                            </span>
                                        }
                                    </div>
                                    <button @onclick="() => selectedDonation = null" class="p-1 rounded hover:bg-surface-container transition-colors">
                                        <span class="material-symbols-outlined text-on-surface-variant text-[20px]">close</span>
                                    </button>
                                </div>
                            </div>

                            <div class="p-5 space-y-5">
                                
                                <div>
                                    <h3 class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-3">Donor Information</h3>
                                    <div class="flex items-center gap-3 mb-3">
                                        <div class="w-12 h-12 rounded-full bg-primary-fixed/50 flex items-center justify-center">
                                            <span class="text-label-md font-label-md text-primary font-bold">@GetInitials(selectedDonation.User?.Name ?? "U")</span>
                                        </div>
                                        <div>
                                            <p class="text-label-md font-label-md text-on-surface font-semibold">@(selectedDonation.User?.Name ?? "Anonymous Donor")</p>
                                            <p class="text-label-sm text-on-surface-variant">@(selectedDonation.User?.Email ?? "No email provided")</p>
                                        </div>
                                    </div>
                                </div>

                                
                                <div>
                                    <h3 class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Campaign</h3>
                                    <div class="flex items-center gap-2 p-3 rounded-lg bg-surface-container/40 border border-outline-variant/15">
                                        <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 0;">campaign</span>
                                        <p class="text-label-md font-label-md text-on-surface">@(selectedDonation.Campaign?.Title ?? "General Fund")</p>
                                    </div>
                                </div>

                                
                                <div class="grid grid-cols-2 gap-4">
                                    <div class="p-3 rounded-lg bg-surface-container/40 border border-outline-variant/15">
                                        <p class="text-label-sm font-label-sm text-on-surface-variant mb-1">Amount</p>
                                        <p class="text-headline-md font-headline-md text-on-surface">@FormatCurrency(selectedDonation.Amount)</p>
                                    </div>
                                    <div class="p-3 rounded-lg bg-surface-container/40 border border-outline-variant/15">
                                        <p class="text-label-sm font-label-sm text-on-surface-variant mb-1">Date</p>
                                        <p class="text-label-md font-label-md text-on-surface">@selectedDonation.CreatedDate.ToString("dd MMM yyyy")</p>
                                        <p class="text-label-sm text-on-surface-variant">@selectedDonation.CreatedDate.ToString("HH:mm:ss")</p>
                                    </div>
                                </div>

                                
                                <div>
                                    <h3 class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider mb-2">Audit Details</h3>
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between py-2 border-b border-outline-variant/10">
                                            <span class="text-label-md text-on-surface-variant">Reference ID</span>
                                            <span class="text-label-md font-label-md text-on-surface font-mono">REF-@selectedDonation.Id.ToString("D5")</span>
                                        </div>
                                        <div class="flex items-center justify-between py-2 border-b border-outline-variant/10">
                                            <span class="text-label-md text-on-surface-variant">Donor ID</span>
                                            <span class="text-label-md font-label-md text-on-surface font-mono">USR-@selectedDonation.UserId.ToString("D4")</span>
                                        </div>
                                        <div class="flex items-center justify-between py-2 border-b border-outline-variant/10">
                                            <span class="text-label-md text-on-surface-variant">Campaign ID</span>
                                            <span class="text-label-md font-label-md text-on-surface font-mono">CMP-@selectedDonation.CampaignId.ToString("D4")</span>
                                        </div>
                                        <div class="flex items-center justify-between py-2">
                                            <span class="text-label-md text-on-surface-variant">Payment Method</span>
