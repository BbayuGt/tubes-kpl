@code {
    private List<DonationModel> allDonations = new();
    private List<DonationModel> filteredDonations = new();
    private DonationModel? selectedDonation = null;
    private bool isLoading = true;
    private string activeFilter = "all";
    private bool showProofModal = false;

    private void OpenProofModal() => showProofModal = true;
    private void CloseProofModal() => showProofModal = false;

    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success";

    private int pendingCount => allDonations.Count(d => GetDonationStatus(d.Id) == "pending");
    private int verifiedCount => allDonations.Count(d => GetDonationStatus(d.Id) == "verified");
    private int rejectedCount => allDonations.Count(d => GetDonationStatus(d.Id) == "rejected");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allDonations = await ApiService.GetAllDonationsAsync();
            ApplyFilter();
        }
        catch
        {
            allDonations = new List<DonationModel>();
            filteredDonations = new List<DonationModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDonationStatus(int donationId)
    {
        var donation = allDonations.FirstOrDefault(d => d.Id == donationId);
        return donation?.Status?.ToLower() ?? "pending";
    }

    private string searchQuery = "";

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = allDonations.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(d => 
                (d.User?.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (d.User?.Email?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (d.Campaign?.Title?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                d.Id.ToString().Contains(searchQuery)
            );
        }

        filteredDonations = activeFilter switch
        {
            "pending" => query.Where(d => GetDonationStatus(d.Id) == "pending").ToList(),
            "verified" => query.Where(d => GetDonationStatus(d.Id) == "verified").ToList(),
            "rejected" => query.Where(d => GetDonationStatus(d.Id) == "rejected").ToList(),
            _ => query.ToList()
        };
    }

    private void SelectDonation(DonationModel donation)
    {
        selectedDonation = donation;
    }

    private async Task ApproveDonation(int donationId)
    {
        var donation = allDonations.FirstOrDefault(d => d.Id == donationId);
        if (donation != null)
        {
            var success = await ApiService.UpdateDonationStatusAsync(donationId, "verified");
            if (success)
            {
                donation.Status = "verified";
                ApplyFilter();
                await ShowToast("Donation REF-" + donationId.ToString("D5") + " has been verified successfully.", "success");
            }
            else
            {
                await ShowToast("Failed to update status in backend.", "error");
            }
        }
    }

    private async Task RejectDonation(int donationId)
    {
        var donation = allDonations.FirstOrDefault(d => d.Id == donationId);
        if (donation != null)
        {
            var success = await ApiService.UpdateDonationStatusAsync(donationId, "rejected");
            if (success)
            {
                donation.Status = "rejected";
                ApplyFilter();
                await ShowToast("Donation REF-" + donationId.ToString("D5") + " has been rejected.", "error");
            }
            else
            {
                await ShowToast("Failed to update status in backend.", "error");
            }
        }
    }

    private async Task ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
        showToast = true;
        StateHasChanged();

        await Task.Delay(4000);
        showToast = false;
        StateHasChanged();
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1_000_000)
            return $"Rp {amount / 1_000_000:N1}M";
        if (amount >= 1_000)
            return $"Rp {amount / 1_000:N0}K";
        return $"Rp {amount:N0}";
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts[0][0].ToString().ToUpper();
    }
}
