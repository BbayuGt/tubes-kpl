@page "/"
@page "/donation"

@inject NavigationManager Nav

<div class="container mt-4">

    <div class="row">

        <!-- Campaign Section -->
        <div class="col-md-8">

            <div class="card mb-4">
                <div class="card-body">

                    <h2>Clean Water for Sahel</h2>

                    <p>
                        Providing sustainable solar-powered wells to
                        drought-affected communities.
                    </p>

                    <div class="progress mb-2">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:65%">
                        </div>
                    </div>

                    <p>
                        <strong>Rp 325.000.000</strong>
                        / Rp 500.000.000
                    </p>

                </div>
            </div>

            <!-- Amount Selection -->
            <div class="card">
                <div class="card-body">

                    <h4>Select Amount</h4>

                    <div class="row g-2 mt-2">

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(10000)">
                                Rp 10.000
                            </button>
                        </div>

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(25000)">
                                Rp 25.000
                            </button>
                        </div>

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(50000)">
                                Rp 50.000
                            </button>
                        </div>

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(100000)">
                                Rp 100.000
                            </button>
                        </div>

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(250000)">
                                Rp 250.000
                            </button>
                        </div>

                        <div class="col-4">
                            <button class="btn btn-outline-primary w-100"
                                    @onclick="() => SetAmount(500000)">
                                Rp 500.000
                            </button>
                        </div>

                    </div>

                    <div class="mt-3">
                        <label class="form-label">
                            Custom Amount
                        </label>

                        <input type="number"
                               class="form-control"
                               @bind="CustomAmount" />
                    </div>

                </div>
            </div>

        </div>

        <!-- Summary Section -->
        <div class="col-md-4">

            <div class="card">
                <div class="card-body">

                    <h4>Donation Summary</h4>

                    <hr />

                    <p>
                        <strong>Campaign:</strong><br />
                        Clean Water for Sahel
                    </p>

                    <p>
                        <strong>Donation Amount:</strong><br />
                        Rp @FinalAmount.ToString("N0")
                    </p>

                    <p>
                        <strong>Platform Fee:</strong><br />
                        Rp 0
                    </p>

                    <hr />

                    <h3>
                        Rp @FinalAmount.ToString("N0")
                    </h3>

                    <button class="btn btn-primary w-100 mt-3"
                            @onclick="Donate">
                        Continue to QRIS Payment
                    </button>

                </div>
            </div>

        </div>

    </div>

</div>

@code {

    private decimal SelectedAmount = 100000;

    private decimal CustomAmount = 0;

    private decimal FinalAmount =>
        CustomAmount > 0
            ? CustomAmount
            : SelectedAmount;

    private void SetAmount(decimal amount)
    {
        SelectedAmount = amount;
        CustomAmount = 0;
    }

    private void Donate()
    {
        Nav.NavigateTo("/payment");
    }

}