@page "/success"

@using Microsoft.AspNetCore.WebUtilities
@using System.Globalization

@inject NavigationManager Nav

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body text-center">

                <h1 class="text-success">
                    Thank You!
                </h1>

                <p class="mt-3">
                    Your donation has been successfully recorded.
                </p>

                <hr />

                <p>
                    <strong>Campaign</strong>
                </p>

                <p>
                    Clean Water for Sahel
                </p>

                <p>
                    <strong>Amount</strong>
                </p>

                <p>
                    Rp @PaymentAmount.ToString("N0")
                </p>

                <p>
                    <strong>Status</strong>
                </p>

                <p class="text-success">
                    @TransactionStatusLabel
                </p>

                <button class="btn btn-primary mt-3"
                        @onclick="BackToDonation">

                    Back to Donation Page

                </button>

            </div>

        </div>

    </div>

</div>

@code {
    private const string PaidStatus = "PAID";
    private decimal PaymentAmount = 100000;
    private string TransactionStatus = PaidStatus;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (decimal.TryParse(
            query["amount"],
            NumberStyles.Number,
            CultureInfo.InvariantCulture,
            out var amount) && amount > 0)
        {
            PaymentAmount = amount;
        }

        var status = query["status"].ToString();
        if (!string.IsNullOrWhiteSpace(status))
        {
            TransactionStatus = status.ToUpperInvariant();
        }
    }

    private string TransactionStatusLabel =>
        TransactionStatus == PaidStatus ? "Berhasil" : TransactionStatus;

    private void BackToDonation()
    {
        Nav.NavigateTo("/donation");
    }

}
