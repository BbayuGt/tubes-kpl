@page "/success"

@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-body text-center">

                <h1 class="text-success">
                    Thank You!
                </h1>

                <p class="mt-3">
                    Your donation has been successfully recorded.
                </p>

                <hr />

                <p>
                    <strong>Campaign</strong>
                </p>

                <p>
                    @(CampaignTitle ?? "Loading...")
                </p>

                <p>
                    <strong>Amount</strong>
                </p>

                <p>
                    Rp @DonationAmount.ToString("N0")
                </p>

                <button class="btn btn-primary mt-3"
                        @onclick="BackToDonation">

                    Back to Donation Page

                </button>

            </div>

        </div>

    </div>

</div>

@code {

    private decimal DonationAmount = 0;
    private string? CampaignTitle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var amountStr = await JS.InvokeAsync<string>("localStorage.getItem", "donationAmount");
            if (decimal.TryParse(amountStr, out var amount))
            {
                DonationAmount = amount;
            }

            CampaignTitle = await JS.InvokeAsync<string>("localStorage.getItem", "donationCampaign");

            StateHasChanged();
        }
    }

    private void BackToDonation()
    {
        Nav.NavigateTo("/");
    }

}