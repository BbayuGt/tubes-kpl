@page "/signup"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<HeadContent>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {
                            "lineHeight": "40px",
                            "letterSpacing": "-0.01em",
                            "fontWeight": "600"
                        }],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f6faff;
            color: #141d23;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(233, 236, 239, 0.5);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #c2c6d4;
            border-radius: 0.5rem;
            background-color: #ffffff;
            color: #141d23;
            transition: all 0.2s ease;
            font-family: 'Inter', sans-serif;
            font-size: 16px;
        }

        .form-input:focus {
            outline: none;
            border-color: #0056b3;
            box-shadow: 0 0 0 2px rgba(0, 86, 179, 0.1);
        }

        .btn-social {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 12px;
            border: 1px solid #c2c6d4;
            border-radius: 0.5rem;
            background-color: #ffffff;
            color: #424752;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-social:hover {
            background-color: #f6faff;
            border-color: #0056b3;
            color: #0056b3;
        }
    </style>
</HeadContent>

<PageTitle>Register - HumanityFlow</PageTitle>

<div class="min-h-screen flex flex-col antialiased">
<!-- TopNavBar (Transactional - Suppressed regular nav items as per rule for Sign-up) -->
<nav class="bg-surface-container-lowest w-full shadow-sm z-50">
    <div class="flex justify-between items-center w-full px-base md:px-margin-desktop max-w-container-max mx-auto h-20">
        <a class="text-headline-md font-headline-md font-bold text-primary flex items-center gap-2" href="#">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
            HumanityFlow
        </a>
        <div class="flex items-center gap-4">
            <span
                class="font-body-md text-body-md text-on-surface-variant hidden md:block">Already have an account?</span>
            <a class="font-label-md text-label-md text-primary font-bold hover:text-primary-container transition-colors"
               href="#">Log In</a>
        </div>
    </div>
</nav>
<!-- Main Content Canvas -->
<main class="flex-grow flex items-center justify-center py-12 px-4 md:px-8 relative overflow-hidden">
    <!-- Abstract Background Decorative Elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div
            class="absolute top-[-10%] right-[-5%] w-[40vw] h-[40vw] rounded-full bg-primary-fixed opacity-30 blur-3xl"></div>
        <div
            class="absolute bottom-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-tertiary-fixed opacity-20 blur-3xl"></div>
    </div>
    <div class="max-w-[1000px] w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left Side: Value Proposition / Imagery -->
        <div class="hidden lg:flex lg:col-span-5 flex-col gap-6 pr-8">
            <h1 class="font-display-lg text-display-lg text-primary">Ayo donasi dengan transparansi.</h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant">Buat akun anda agar anda dapat melihat pengaruh
                donasi anda, melihat kontribusi, dan mencari kemana setiap Rupiah anda pergi</p>
            <div class="flex items-center gap-3 mt-4 text-secondary">
                <span class="material-symbols-outlined">shield_lock</span>
                <span class="font-label-md text-label-md">Bank-level security for all transactions</span>
            </div>
        </div>
        <!-- Right Side: Registration Form -->
        <div class="lg:col-span-7">
            <div class="glass-panel rounded-xl p-8 md:p-10 w-full max-w-[540px] mx-auto lg:ml-auto lg:mr-0">
                <div class="mb-8">
                    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Create Account</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant">Start making a measurable difference
                        today.</p>
                </div>
                <!-- Form -->
                <EditForm Model="this" OnValidSubmit="HandleRegister" FormName="registerForm" class="flex flex-col gap-5">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="bg-error-container text-on-error-container p-3 rounded text-sm mb-2">
                            @errorMessage
                        </div>
                    }
                    @if (isSuccess)
                    {
                        <div class="bg-tertiary-container text-on-tertiary-container p-3 rounded text-sm mb-2">
                            Registration successful! Redirecting to login...
                        </div>
                    }
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1"
                               for="firstName">Nama</label>
                        <input @bind="firstName" class="form-input" id="firstName" name="firstName" placeholder="Jane" required=""
                               type="text"/>
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1"
                               for="email">Email</label>
                        <input @bind="email" class="form-input" id="email" name="email" placeholder="jane@example.com" required=""
                               type="email"/>
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant mb-1" for="password">Password</label>
                        <div class="relative">
                            <input @bind="password" class="form-input pr-10" id="password" name="password" placeholder="••••••••"
                                   required="" type="password"/>
                            <button
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-primary transition-colors"
                                type="button">
                                <span class="material-symbols-outlined text-[20px]">visibility_off</span>
                            </button>
                        </div>
                        <p class="font-label-sm text-[11px] text-on-surface-variant mt-1">Must be at least 8
                            characters.</p>
                    </div>
                    <div class="flex flex-col gap-3 mt-2">
                        <label class="flex items-start gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center mt-1">
                                <input
                                    class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary focus:ring-offset-0 transition-colors cursor-pointer appearance-none checked:bg-primary checked:border-primary"
                                    required="" type="checkbox"/>
                                <span
                                    class="material-symbols-outlined text-[14px] text-white absolute pointer-events-none opacity-0 group-has-[:checked]:opacity-100 transition-opacity">check</span>
                            </div>
                            <span class="font-body-md text-[14px] text-on-surface-variant leading-tight">
                                I agree to the <a class="text-primary hover:underline" href="#">Terms of Service</a> and <a
                                                                                                                             class="text-primary hover:underline" href="#">Privacy Policy</a>.
                            </span>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer group">
                            <div class="relative flex items-center justify-center mt-1">
                                <input
                                    class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary focus:ring-offset-0 transition-colors cursor-pointer appearance-none checked:bg-primary checked:border-primary"
                                    type="checkbox"/>
                                <span
                                    class="material-symbols-outlined text-[14px] text-white absolute pointer-events-none opacity-0 group-has-[:checked]:opacity-100 transition-opacity">check</span>
                            </div>
                            <span class="font-body-md text-[14px] text-on-surface-variant leading-tight">
                                Send me updates on campaigns and impact reports.
                            </span>
                        </label>
                    </div>
                    <button
                        class="mt-4 w-full bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md py-3 px-6 rounded-lg font-semibold transition-colors shadow-sm flex items-center justify-center gap-2"
                        type="submit">
                        Create Account
                        <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</main>
<!-- Footer (Transactional minimalist footer) -->
<footer class="bg-surface-container-high w-full py-6 mt-auto border-t border-surface-variant">
    <div
        class="px-base md:px-margin-desktop max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="font-body-md text-[14px] text-on-surface-variant">© 2026 HumanityFlow.</p>
    </div>
</footer>

@inject IJSRuntime JSRuntime
@code {
    private string firstName = "";
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isSuccess;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/", true);
            }
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;
        isSuccess = false;
        var client = HttpClientFactory.CreateClient("BackendAPI");
        
        try
        {
            var response = await client.PostAsJsonAsync("api/Auth/register", new { Name = firstName, Email = email, Password = password });
            
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorText) ? "Registration failed." : errorText;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while trying to register: " + ex.Message;
        }
    }
}
</div>