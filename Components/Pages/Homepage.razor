@page "/"
@using tubes_kpl.Models
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory

<HeadContent>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>HumanityFlow - Homepage</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
<style>
        body { background-color: theme('colors.background'); color: theme('colors.on-background'); font-family: 'Inter', sans-serif; }
        .shadow-level-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-level-2 { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
    </style>
</HeadContent>
<div class="antialiased flex flex-col min-h-screen">
<TopNavBar />
<main class="flex-grow">
<HeroSection />
<CategoriesSection />
<!-- Urgent Campaigns Grid -->
<section class="py-16 px-base md:px-margin-desktop bg-surface-bright">
<div class="max-w-container-max mx-auto">
<div class="flex justify-between items-end mb-8">
<div>
<h2 class="font-headline-lg text-headline-lg text-on-surface mb-2">Urgent Campaigns</h2>
<p class="font-body-md text-body-md text-on-surface-variant">These causes need immediate attention and funding.</p>
</div>
<a class="hidden sm:flex items-center gap-1 font-label-md text-label-md text-primary hover:underline" href="#">View All <span class="material-symbols-outlined text-[20px]">arrow_forward</span></a>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
@if (campaigns == null)
{
    <p>Loading campaigns...</p>
}
else if (!campaigns.Any())
{
    <p>No campaigns found.</p>
}
else
{
    @foreach (var campaign in campaigns)
    {
        <CampaignCard Campaign="campaign" />
    }
}
</div>
</div>
</section>
<HowItWorksSection />
</main>
<AppFooter />
@code {
    private List<Models.Campaign>? campaigns;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("BackendAPI");
        try
        {
            campaigns = await client.GetFromJsonAsync<List<Models.Campaign>>("api/Campaign");
        }
        catch
        {
            campaigns = new List<Models.Campaign>();
        }
    }
}
</div>