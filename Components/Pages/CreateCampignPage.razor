@code {
    private Campaign newCampaign = new Campaign();
    private string? token;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
                if (string.IsNullOrEmpty(token))
                {
                    NavigationManager.NavigateTo("/login");
                    return;
                }

                var client = HttpClientFactory.CreateClient("BackendAPI");
                client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                var response = await client.GetAsync("/api/auth/me");
                if (!response.IsSuccessStatusCode)
                {
                    NavigationManager.NavigateTo("/login");
                    return;
                }
            }
            catch (Exception)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }
        }
    }

    private bool isSubmitting = false;
    private string errorMessage = "";

    private async Task PublishCampaign()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("BackendAPI");
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await client.PostAsJsonAsync("/api/campaign", newCampaign);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/penyelenggara/dashboard");
            }
            else
            {
                var errorTxt = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorTxt) ? $"Error publishing campaign: {response.StatusCode}" : errorTxt;
                Console.WriteLine(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    public class Campaign
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal TargetAmount { get; set; }
        public string ImageUrl { get; set; } = "https://placehold.co/600x400"; // Default placeholder image
    }
}