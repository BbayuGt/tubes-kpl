@page "/login"

<PageTitle>Home</PageTitle>

<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
<style>
        /* Ambient shadows and utilities */
        .shadow-ambient-1 { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); }
        .shadow-ambient-2 { box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08); }
        .bg-subtle-pattern {
            background-color: #f6faff;
            background-image: radial-gradient(#dbe4ed 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="bg-background min-h-screen flex flex-col font-sans text-on-surface antialiased bg-subtle-pattern">
<!-- TopNavBar (Suppressed due to Linear/Transactional intent, but keeping brand identity minimal) -->
<header class="w-full py-6 px-base md:px-margin-desktop text-center md:text-left absolute top-0 left-0">
<a class="inline-block" href="#">
<span class="text-headline-md font-headline-md font-bold text-primary">HumanityFlow</span>
</a>
</header>
<!-- Main Content Canvas -->
<main class="flex-grow flex items-center justify-center p-4 sm:p-8 mt-16 md:mt-0">
<div class="w-full max-w-[480px]">
<!-- Login Card -->
<div class="bg-surface-container-lowest rounded-xl shadow-ambient-2 p-8 sm:p-10 border border-outline-variant/30">
<div class="text-center mb-8">
<h1 class="text-headline-lg font-headline-lg text-on-surface mb-2">Welcome Back</h1>
<p class="text-body-md font-body-md text-on-surface-variant">Sign in to continue your impact journey.</p>
</div>
<!-- Social Logins -->
<div class="flex flex-col gap-4 mb-8">
<button class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest hover:bg-surface-container-low transition-colors duration-200">
<svg class="w-5 h-5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
</svg>
<span class="text-label-md font-label-md text-on-surface">Continue with Google</span>
</button>
<button class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest hover:bg-surface-container-low transition-colors duration-200">
<svg class="w-5 h-5 text-[#1877F2]" fill="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
</svg>
<span class="text-label-md font-label-md text-on-surface">Continue with Facebook</span>
</button>
</div>
<!-- Divider -->
<div class="flex items-center gap-4 mb-8">
<div class="h-px bg-outline-variant flex-grow"></div>
<span class="text-label-sm font-label-sm text-on-surface-variant uppercase tracking-wider">Or email</span>
<div class="h-px bg-outline-variant flex-grow"></div>
</div>
<!-- Form -->
<form action="#" class="flex flex-col gap-5" method="POST">
<!-- Email Field -->
<div class="relative group">
<input class="peer w-full px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface text-body-md placeholder-transparent focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="email" name="email" placeholder="Email address" required="" type="email"/>
<label class="absolute left-3 -top-2.5 bg-surface-container-lowest px-1 text-label-sm text-on-surface-variant transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-3 peer-placeholder-shown:text-on-surface-variant peer-focus:-top-2.5 peer-focus:text-label-sm peer-focus:text-primary" for="email">
                            Email address
                        </label>
</div>
<!-- Password Field -->
<div class="relative group">
<input class="peer w-full px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface text-body-md placeholder-transparent focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all" id="password" name="password" placeholder="Password" required="" type="password"/>
<label class="absolute left-3 -top-2.5 bg-surface-container-lowest px-1 text-label-sm text-on-surface-variant transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-3 peer-placeholder-shown:text-on-surface-variant peer-focus:-top-2.5 peer-focus:text-label-sm peer-focus:text-primary" for="password">
                            Password
                        </label>
</div>
<div class="flex items-center justify-between mt-1">
<div class="flex items-center">
<input class="h-4 w-4 rounded border-outline text-primary focus:ring-primary" id="remember-me" name="remember-me" type="checkbox"/>
<label class="ml-2 block text-label-md font-label-md text-on-surface-variant" for="remember-me">
                                Remember me
                            </label>
</div>
<div class="text-sm">
<a class="text-label-md font-label-md text-primary hover:text-primary-container hover:underline transition-colors" href="#">
                                Forgot password?
                            </a>
</div>
</div>
<button class="w-full flex justify-center py-3 px-4 border border-transparent rounded bg-primary text-on-primary text-label-md font-label-md font-bold hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors shadow-sm mt-2" type="submit">
                        Sign In
                    </button>
</form>
<div class="mt-8 text-center">
<p class="text-body-md font-body-md text-on-surface-variant">
                        Don't have an account? 
                        <a class="text-primary hover:text-primary-container font-semibold hover:underline transition-colors" href="#">Register here</a>
</p>
</div>
</div>
<!-- Trust Indicators -->
<div class="mt-8 flex justify-center gap-6 text-on-surface-variant">
<div class="flex items-center gap-1 opacity-80">
<span class="material-symbols-outlined text-[20px]" data-icon="lock" style="font-variation-settings: 'FILL' 0;">lock</span>
<span class="text-label-sm font-label-sm">Secure Login</span>
</div>
<div class="flex items-center gap-1 opacity-80">
<span class="material-symbols-outlined text-[20px]" data-icon="verified_user" style="font-variation-settings: 'FILL' 0;">verified_user</span>
<span class="text-label-sm font-label-sm">Privacy Protected</span>
</div>
</div>
</div>
</main>
<!-- Footer (Suppressed due to Linear/Transactional intent, minimal required layout) -->
<footer class="w-full py-6 px-base md:px-margin-desktop text-center text-on-surface-variant">
<p class="text-label-sm font-label-sm opacity-60">© 2024 HumanityFlow. All rights reserved.</p>
</footer>
</body></html>