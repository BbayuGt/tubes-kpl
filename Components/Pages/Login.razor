@page "/login"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<HeadContent>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-container": "#bbd0ff",
                        "on-error-container": "#93000a",
                        "on-background": "#141d23",
                        "error-container": "#ffdad6",
                        "background": "#f6faff",
                        "on-secondary-fixed-variant": "#454748",
                        "on-tertiary-fixed": "#002106",
                        "inverse-surface": "#293138",
                        "tertiary": "#004c17",
                        "surface-bright": "#f6faff",
                        "outline-variant": "#c2c6d4",
                        "surface-variant": "#dbe4ed",
                        "surface-dim": "#d2dbe4",
                        "on-surface-variant": "#424752",
                        "on-secondary-container": "#626566",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#6fe87c",
                        "secondary-container": "#e1e3e4",
                        "inverse-primary": "#acc7ff",
                        "tertiary-container": "#006722",
                        "surface-container-high": "#e0e9f2",
                        "on-tertiary": "#ffffff",
                        "secondary": "#5c5f60",
                        "outline": "#727784",
                        "secondary-fixed": "#e1e3e4",
                        "surface-container-highest": "#dbe4ed",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#001a40",
                        "primary-container": "#0056b3",
                        "surface-tint": "#115cb9",
                        "on-primary": "#ffffff",
                        "primary": "#003f87",
                        "on-surface": "#141d23",
                        "on-error": "#ffffff",
                        "tertiary-fixed": "#83fc8e",
                        "surface-container-low": "#ecf5fe",
                        "surface-container": "#e6eff8",
                        "surface": "#f6faff",
                        "primary-fixed-dim": "#acc7ff",
                        "primary-fixed": "#d7e2ff",
                        "inverse-on-surface": "#e9f2fb",
                        "tertiary-fixed-dim": "#66df75",
                        "on-tertiary-fixed-variant": "#00531a",
                        "on-secondary-fixed": "#191c1d",
                        "secondary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#004491"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "gutter": "24px",
                        "margin-desktop": "40px",
                        "base": "8px",
                        "container-max": "1280px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                        "headline-lg": ["32px", {
                            "lineHeight": "40px",
                            "letterSpacing": "-0.01em",
                            "fontWeight": "600"
                        }],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "600"}],
                        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
    <style>
        /* Ambient shadows and utilities */
        .shadow-ambient-1 {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }

        .shadow-ambient-2 {
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .bg-subtle-pattern {
            background-color: #f6faff;
            background-image: radial-gradient(#dbe4ed 1px, transparent 1px);
            background-size: 24px 24px;
        }
    </style>
</HeadContent>

<PageTitle>Login - HumanityFlow</PageTitle>

<div class="bg-background min-h-screen flex flex-col font-sans text-on-surface antialiased bg-subtle-pattern">
<!-- TopNavBar (Suppressed due to Linear/Transactional intent, but keeping brand identity minimal) -->
<header class="w-full py-6 px-base md:px-margin-desktop text-center md:text-left absolute top-0 left-0">
    <a class="inline-block" href="#">
        <span class="text-headline-md font-headline-md font-bold text-primary">HumanityFlow</span>
    </a>
</header>
<!-- Main Content Canvas -->
<main class="flex-grow flex items-center justify-center p-4 sm:p-8 mt-16 md:mt-0">
    <div class="w-full max-w-[480px]">
        <!-- Login Card -->
        <div
            class="bg-surface-container-lowest rounded-xl shadow-ambient-2 p-8 sm:p-10 border border-outline-variant/30">
            <div class="text-center mb-8">
                <h1 class="text-headline-lg font-headline-lg text-on-surface mb-2">Welcome Back</h1>
                <p class="text-body-md font-body-md text-on-surface-variant">Sign in to continue your impact
                    journey.</p>
            </div>
            <!-- Form -->
            <EditForm Model="this" OnValidSubmit="HandleLogin" FormName="loginForm" class="flex flex-col gap-5">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="bg-error-container text-on-error-container p-3 rounded text-sm mb-2">
                        @errorMessage
                    </div>
                }
                <!-- Email Field -->
                <div class="relative group">
                    <input @bind="email"
                        class="peer w-full px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface text-body-md placeholder-transparent focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                        id="email" name="email" placeholder="Email address" required="" type="email"/>
                    <label
                        class="absolute left-3 -top-2.5 bg-surface-container-lowest px-1 text-label-sm text-on-surface-variant transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-3 peer-placeholder-shown:text-on-surface-variant peer-focus:-top-2.5 peer-focus:text-label-sm peer-focus:text-primary"
                        for="email">
                        Email address
                    </label>
                </div>
                <!-- Password Field -->
                <div class="relative group">
                    <input @bind="password"
                        class="peer w-full px-4 py-3 rounded border border-outline-variant bg-surface-container-lowest text-on-surface text-body-md placeholder-transparent focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                        id="password" name="password" placeholder="Password" required="" type="password"/>
                    <label
                        class="absolute left-3 -top-2.5 bg-surface-container-lowest px-1 text-label-sm text-on-surface-variant transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-3 peer-placeholder-shown:text-on-surface-variant peer-focus:-top-2.5 peer-focus:text-label-sm peer-focus:text-primary"
                        for="password">
                        Password
                    </label>
                </div>
                <div class="flex items-center justify-between mt-1">
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-outline text-primary focus:ring-primary" id="remember-me"
                               name="remember-me" type="checkbox"/>
                        <label class="ml-2 block text-label-md font-label-md text-on-surface-variant" for="remember-me">
                            Remember me
                        </label>
                    </div>
                </div>
                <button
                    class="w-full flex justify-center py-3 px-4 border border-transparent rounded bg-primary text-on-primary text-label-md font-label-md font-bold hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors shadow-sm mt-2"
                    type="submit">
                    Sign In
                </button>
            </EditForm>
            <div class="mt-8 text-center">
                <p class="text-body-md font-body-md text-on-surface-variant">
                    Don't have an account?
                    <a class="text-primary hover:text-primary-container font-semibold hover:underline transition-colors"
                       href="/signup">Register here</a>
                </p>
            </div>
        </div>
        <!-- Trust Indicators -->
        <div class="mt-8 flex justify-center gap-6 text-on-surface-variant">
            <div class="flex items-center gap-1 opacity-80">
                <span class="material-symbols-outlined text-[20px]" data-icon="lock"
                      style="font-variation-settings: 'FILL' 0;">lock</span>
                <span class="text-label-sm font-label-sm">Secure Login</span>
            </div>
            <div class="flex items-center gap-1 opacity-80">
                <span class="material-symbols-outlined text-[20px]" data-icon="verified_user"
                      style="font-variation-settings: 'FILL' 0;">verified_user</span>
                <span class="text-label-sm font-label-sm">Privacy Protected</span>
            </div>
        </div>
    </div>
</main>
<!-- Footer (Suppressed due to Linear/Transactional intent, minimal required layout) -->
<footer class="w-full py-6 px-base md:px-margin-desktop text-center text-on-surface-variant">
    <p class="text-label-sm font-label-sm opacity-60">© 2026 HumanityFlow.</p>
</footer>

@inject IJSRuntime JSRuntime
@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/", true);
            }
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        var client = HttpClientFactory.CreateClient("BackendAPI");
        
        try
        {
            var response = await client.PostAsJsonAsync("api/Auth/login", new { Email = email, Password = password });
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                if (result.TryGetProperty("token", out var tokenProp))
                {
                    var token = tokenProp.GetString();
                    if (!string.IsNullOrEmpty(token))
                    {
                        var role = GetRoleFromToken(token);
                        if (role == "User")
                        {
                            errorMessage = "Regular user does not need to log in to donate.";
                            return;
                        }

                        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", token);

                        if (role == "Admin")
                        {
                            NavigationManager.NavigateTo("/admin", true);
                        }
                        else if (role == "penyelenggara")
                        {
                            NavigationManager.NavigateTo("/penyelenggara/dashboard", true);
                        }
                        else
                        {
                            NavigationManager.NavigateTo("/", true);
                        }
                        return;
                    }
                }
                NavigationManager.NavigateTo("/", true);
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = string.IsNullOrEmpty(errorText) ? "Login failed." : errorText;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while trying to log in: " + ex.Message;
        }
    }

    private string GetRoleFromToken(string token)
    {
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return "";
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            switch (payload.Length % 4)
            {
                case 2: payload += "=="; break;
                case 3: payload += "="; break;
            }
            var jsonBytes = Convert.FromBase64String(payload);
            var json = System.Text.Encoding.UTF8.GetString(jsonBytes);
            var jsonDoc = System.Text.Json.JsonDocument.Parse(json);
            
            if (jsonDoc.RootElement.TryGetProperty("role", out var roleProp))
            {
                return roleProp.GetString() ?? "";
            }
            if (jsonDoc.RootElement.TryGetProperty("http://schemas.microsoft.com/ws/2008/06/identity/claims/role", out var rolePropLong))
            {
                return rolePropLong.GetString() ?? "";
            }
        }
        catch {}
        return "";
    }
}
</div>