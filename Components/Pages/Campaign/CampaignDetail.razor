<script>
        // Micro-interaction for donation buttons
        const donationButtons = document.querySelectorAll('.grid-cols-2 button');
        donationButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                donationButtons.forEach(b => {
                    b.classList.remove('border-primary', 'bg-primary-fixed-dim', 'text-primary');
                    b.classList.add('border-outline-variant');
                });
                btn.classList.add('border-primary', 'bg-primary-fixed-dim', 'text-primary');
                btn.classList.remove('border-outline-variant');
            });
        });
    </script>
