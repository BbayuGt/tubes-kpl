@page "/campaign-detail/{Id:int}"
@using tubes_kpl.Models

@if (Campaign == null)
{
    <div class="flex justify-center items-center h-screen bg-[#f6faff] text-[#003f87]">
        <h3 class="text-2xl font-bold">Memuat data kampanye...</h3>
    </div>
}
else
{
    <!DOCTYPE html>
    <html class="light" lang="en">
    <head>
        <meta charset="utf-8">
        <meta content="width=device-width, initial-scale=1.0" name="viewport">
        <title>HumanityFlow - @Campaign.Title</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
        <script src="https://cdn.tailwindcss.com"></script>
        <style>
            body { background-color: #f6faff; font-family: 'Inter', sans-serif; }
            .sticky-card { position: sticky; top: 24px; }
            .progress-bar-fill { transition: width 1s ease; }
        </style>
    </head>
    <body class="bg-[#f6faff] text-[#141d23]">
        <header class="bg-white border-b shadow-sm h-16 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-10 h-full flex justify-between items-center">
                <div class="text-2xl font-bold text-[#003f87]">HumanityFlow</div>
                <nav class="hidden md:flex gap-8">
                    <a class="text-[#003f87] border-b-2 border-[#003f87] pb-1">Explore</a>
                    <a class="text-gray-500 hover:text-[#003f87]">Impact</a>
                    <a class="text-gray-500 hover:text-[#003f87]">Transparency</a>
                    <a class="text-gray-500 hover:text-[#003f87]">About</a>
                </nav>
                <button class="bg-[#003f87] text-white px-6 py-2 rounded-lg font-bold">Sign In</button>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-10 py-8">
            <div class="mb-8">
                <a class="flex items-center gap-2 text-[#003f87] font-bold cursor-pointer">
                    <span class="material-symbols-outlined">arrow_back</span> Back to Campaigns
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
                <div class="md:col-span-8">
                    <div class="rounded-xl overflow-hidden shadow-sm mb-8 aspect-video bg-gray-200">
                        <img src="@Campaign.ImageUrl" class="w-full h-full object-cover" />
                    </div>
                    <div class="mb-8">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-bold flex items-center gap-2">
                                <span class="w-2 h-2 bg-green-600 rounded-full"></span>
                                @(Campaign.IsActive ? "Active" : "Completed")
                            </span>
                            <span class="text-gray-500 text-sm">HumanityFlow Campaign</span>
                        </div>
                        <h1 class="text-5xl font-bold tracking-tight mb-3">@Campaign.Title</h1>
                        <div class="flex items-center gap-2 text-gray-500">
                            <span class="material-symbols-outlined">location_on</span> Indonesia
                        </div>
                    </div>
                    <section>
                        <h2 class="text-2xl font-bold mb-4">Project Overview</h2>
                        <p class="text-lg text-gray-600 leading-relaxed">@Campaign.Description</p>
                    </section>
                    <div class="grid md:grid-cols-2 gap-5 mt-8">
                        <div class="p-5 bg-white rounded-xl border">
                            <span class="material-symbols-outlined text-[#003f87]">water_drop</span>
                            <h3 class="font-bold mt-2">Sustainable Impact</h3>
                            <p class="text-sm text-gray-600">Supporting communities through transparent donations.</p>
                        </div>
                        <div class="p-5 bg-white rounded-xl border">
                            <span class="material-symbols-outlined text-[#003f87]">health_and_safety</span>
                            <h3 class="font-bold mt-2">Social Benefit</h3>
                            <p class="text-sm text-gray-600">Helping improve people's quality of life.</p>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-4">
                    <div class="sticky-card bg-white rounded-xl p-8 shadow-lg border">
                        @{
                            double progress = Campaign.TargetAmount > 0 
                                ? Math.Min(100, (double)Campaign.CollectedAmount / (double)Campaign.TargetAmount * 100) 
                                : 0;
                        }
                        <div class="mb-6">
                            <div class="flex justify-between items-end mb-2">
                                <h3 class="text-2xl font-bold text-[#003f87]">Rp @Campaign.CollectedAmount.ToString("N0")</h3>
                                <span class="text-sm text-gray-500">of Rp @Campaign.TargetAmount.ToString("N0")</span>
                            </div>
                            <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
                                <div class="h-full bg-green-600 rounded-full progress-bar-fill" style="width:@progress%"></div>
                            </div>
                        </div>
                        <label class="font-bold text-sm">Donation Amount</label>
                        <div class="relative mt-2 mb-6">
                            <span class="absolute left-4 top-3 text-gray-500">Rp</span>
                            <input type="number" 
        @bind="DonationAmount" 
       placeholder="0" 
       class="w-full pl-12 py-3 border rounded-lg outline-none focus:border-primary" />
                        </div>
                        <button class="w-full bg-[#003f87] text-white py-4 rounded-lg font-bold hover:bg-blue-800">Donate Now</button>
                        <button class="w-full mt-3 bg-gray-100 text-[#003f87] py-4 rounded-lg font-bold flex justify-center gap-2">
                            <span class="material-symbols-outlined">share</span> Share Campaign
                        </button>
                        <div class="mt-6 p-4 bg-blue-50 rounded-lg flex gap-3">
                            <span class="material-symbols-outlined text-[#003f87]">verified</span>
                            <p class="text-sm text-gray-600">Verified by HumanityFlow transparency system.</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="bg-white border-t mt-10 py-8">
            <div class="max-w-7xl mx-auto px-10">
                <h2 class="text-2xl font-bold text-[#003f87]">HumanityFlow</h2>
                <p class="text-gray-500">Radical transparency in humanitarian aid.</p>
            </div>
        </footer>
    </body>
    </html>
}