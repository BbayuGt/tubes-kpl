@page "/campaign-detail/{Id:int}"
@using tubes_kpl.Models

@if (Campaign == null)
{
    <div class="flex justify-center items-center h-screen bg-[#f6faff] text-[#003f87]">
        <h3 class="text-2xl font-bold">Memuat data kampanye...</h3>
    </div>
}
else
{
    double progress = Campaign.TargetAmount > 0
        ? (double)Campaign.CollectedAmount / (double)Campaign.TargetAmount * 100
        : 0;

    <html class="light">
    <head>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
        <script src="https://cdn.tailwindcss.com"></script>

        <style>
            body {
                background-color: #f6faff;
                font-family: 'Inter', sans-serif;
                color: #141d23;
            }

            .sticky-card {
                position: sticky;
                top: 24px;
            }

            .progress-bar-fill {
                transition: width 1s ease;
            }
        </style>
    </head>

    <body class="bg-[#f6faff]">

        <header class="bg-white border-b shadow-sm h-14 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 h-full flex justify-between items-center">

                <div class="text-2xl font-bold text-[#003f87]">
                    HumanityFlow
                </div>

                <nav class="hidden md:flex gap-8">
                    <a class="text-[#003f87] border-b-2 border-[#003f87] pb-1">
                        Explore
                    </a>
                    <a class="text-gray-500 hover:text-[#003f87]">
                        Impact
                    </a>
                    <a class="text-gray-500 hover:text-[#003f87]">
                        Transparency
                    </a>
                    <a class="text-gray-500 hover:text-[#003f87]">
                        About
                    </a>
                </nav>

                <button class="bg-[#003f87] text-white px-6 py-2 rounded-lg font-bold">
                    Sign In
                </button>

            </div>
        </header>


        <main class="max-w-7xl mx-auto px-6 py-6">

            <div class="mb-4">
                <a class="flex items-center gap-2 text-[#003f87] font-bold">
                    <span class="material-symbols-outlined">
                        arrow_back
                    </span>
                    Back to Campaigns
                </a>
            </div>


            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

                <div class="md:col-span-8">

                    <div class="rounded-xl overflow-hidden shadow-sm aspect-[16/9] bg-gray-200 mb-4">
                        <img src="@Campaign.ImageUrl"
                             class="w-full h-full object-cover" />
                    </div>


                    <div class="mb-8">

                        <div class="flex items-center gap-3 mb-4">

                            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-bold flex items-center gap-2">
                                <span class="w-2 h-2 bg-green-600 rounded-full animate-pulse"></span>
                                @(Campaign.IsActive ? "Active" : "Completed")
                            </span>

                        </div>


                        <h1 class="text-3xl font-bold tracking-tight mb-2">
                            @Campaign.Title
                        </h1>


                        <div class="flex items-center gap-2 text-gray-500">
                            <span class="material-symbols-outlined">
                                calendar_today
                            </span>

                            Created on @Campaign.CreatedAt.ToString("MMMM dd, yyyy")
                        </div>

                    </div>


                    <section>

                        <p class="text-lg text-gray-600 leading-relaxed mb-4">
                            @Campaign.Description
                        </p>

                        <p class="text-base text-gray-600 leading-relaxed mb-4">
                            HumanityFlow memastikan setiap bantuan tersalurkan secara transparan
                            dan dapat dipantau oleh pengguna.
                        </p>


                        <h2 class="text-2xl font-bold mb-3">
                            Implementation Plan
                        </h2>


                        <p class="text-gray-600 leading-relaxed">
                            Dana yang terkumpul akan digunakan sesuai kebutuhan campaign
                            dengan laporan penggunaan yang jelas.
                        </p>

                    </section>

                </div>



                <div class="md:col-span-4">

                    <div class="sticky-card bg-white rounded-xl p-6 shadow-[0_12px_40px_rgba(0,0,0,0.08)] border">

                        <div class="mb-4">

                            <div class="flex justify-between items-end mb-1">

                                <h3 class="text-2xl font-bold text-[#003f87]">
                                    Rp @Campaign.CollectedAmount.ToString("N0")
                                </h3>

                                <span class="text-sm text-gray-500">
                                    of Rp @Campaign.TargetAmount.ToString("N0")
                                </span>

                            </div>


                            <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
                                <div class="h-full bg-green-600 rounded-full progress-bar-fill"
                                     style="width:@progress%">
                                </div>
                            </div>


                            <div class="flex justify-between mt-2 text-sm text-gray-500">

                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">
                                        groups
                                    </span>
                                    Donors
                                </span>


                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">
                                        schedule
                                    </span>
                                    Active
                                </span>

                            </div>

                        </div>


                        <button class="w-full bg-[#003f87] text-white py-3 rounded-lg font-bold shadow hover:opacity-90">
                            Donate Now
                        </button>


                        <div class="mt-4 flex items-start gap-3 p-2 bg-blue-50 rounded-lg border">

                            <span class="material-symbols-outlined text-[#003f87]">
                                verified
                            </span>

                            <p class="text-sm text-gray-600">
                                Verified by HumanityFlow transparency engine.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </main>


        <footer class="bg-white border-t mt-10 py-8">

            <div class="max-w-7xl mx-auto px-10">

                <div class="text-2xl font-bold text-[#003f87]">
                    HumanityFlow
                </div>

                <p class="text-gray-500">
                    © 2024 HumanityFlow. Radical transparency in humanitarian aid.
                </p>

            </div>

        </footer>

    </body>
    </html>
}